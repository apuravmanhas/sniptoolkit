---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  structuredData?: object;
  gaMeasurementId?: string;
}

const { title, description, canonicalUrl, ogImage, structuredData, gaMeasurementId } = Astro.props;
const siteUrl = 'https://sniptoolkit.com';
const rawCanonical = canonicalUrl || `${siteUrl}${Astro.url.pathname}`;
const fullCanonical = rawCanonical.endsWith('/') ? rawCanonical : `${rawCanonical}/`;
const fullOgImage = ogImage || `${siteUrl}/og-default.png`;

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ToastContainer from '../components/ToastContainer.astro';
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, viewport-fit=cover" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="SnipTools" />
  <meta name="theme-color" content="#050505" />
  <link rel="canonical" href={fullCanonical} />

  <!-- Preconnect Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <title>{title}</title>

  <!-- Open Graph / Facebook -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:site_name" content="SnipTools" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />
  <meta name="twitter:site" content="@SnipTools" />
  <meta name="twitter:creator" content="@SnipTools" />

  <!-- Security & Privacy Meta Headers -->
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="Strict-Transport-Security" content="max-age=31536000; includeSubDomains; preload" />
  <meta http-equiv="X-Frame-Options" content="DENY" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />

  <!-- Favicons (Google Search & Mobile Specification) -->
  <link rel="icon" type="image/png" sizes="48x48" href="https://sniptoolkit.com/favicon-48x48.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="https://sniptoolkit.com/favicon-192x192.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="https://sniptoolkit.com/favicon-512x512.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="https://sniptoolkit.com/apple-touch-icon.png" />
  <link rel="shortcut icon" href="https://sniptoolkit.com/favicon.ico" />
  <link rel="manifest" href="/manifest.json" />

  <!-- Structured Data JSON-LD -->
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <!-- Google Analytics GA4 (Measurement ID: G-CH9Q7ZP4DD) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-CH9Q7ZP4DD"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-CH9Q7ZP4DD');
  </script>

  <!-- Theme script (Prevent layout shift / flash) -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('sniptools-theme');
      if (saved === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      }
    })();
  </script>
</head>
<body class="bg-bg-primary text-text-primary relative selection:bg-accent/30 selection:text-white">
  <!-- Ambient background glow effect -->
  <div class="ambient-glow" aria-hidden="true"></div>

  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] focus:bg-accent focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
    Skip to main content
  </a>

  <Header />
  <CommandPalette />

  <main id="main-content" class="min-h-[calc(100vh-140px)] relative z-10">
    <slot />
  </main>

  <Footer />
  <ToastContainer />

  <!-- Global JavaScript Utilities -->
  <script is:inline>
    // Global Theme Switcher
    window.toggleTheme = function() {
      const html = document.documentElement;
      const isLight = html.classList.contains('light');
      if (isLight) {
        html.classList.remove('light');
        html.classList.add('dark');
        localStorage.setItem('sniptools-theme', 'dark');
      } else {
        html.classList.remove('dark');
        html.classList.add('light');
        localStorage.setItem('sniptools-theme', 'light');
      }
    };

    // Toast Popup Notifications
    window.showToast = function(message, type = 'success', duration = 2800) {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      const icons = { success: '✓', error: '✕', info: 'ℹ' };
      toast.textContent = `${icons[type] || '•'} ${message}`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        toast.style.transition = 'all 0.25s ease';
        setTimeout(() => toast.remove(), 250);
      }, duration);
    };

    // Copy to Clipboard
    window.copyToClipboard = async function(text, label = 'Copied to clipboard!') {
      if (!text) {
        window.showToast('Nothing to copy!', 'info');
        return false;
      }
      try {
        await navigator.clipboard.writeText(text);
        window.showToast(label, 'success');
        return true;
      } catch (err) {
        window.showToast('Failed to copy', 'error');
        return false;
      }
    };
  </script>
</body>
</html>
