---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  structuredData?: object;
  gaMeasurementId?: string;
}

const { title, description, canonicalUrl, ogImage, structuredData, gaMeasurementId = 'G-MEASUREMENT_ID' } = Astro.props;
const siteUrl = 'https://sniptools.tools';
const fullCanonical = canonicalUrl || `${siteUrl}${Astro.url.pathname}`;
const fullOgImage = ogImage || `${siteUrl}/og-default.png`;

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ToastContainer from '../components/ToastContainer.astro';
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={fullCanonical} />

  <!-- Preconnect Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <title>{title}</title>

  <!-- Open Graph / Facebook -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={fullCanonical} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:site_name" content="SnipTools" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Structured Data JSON-LD -->
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <!-- Google Analytics GA4 (Placeholder ready for deployment) -->
  {gaMeasurementId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${gaMeasurementId}');
      `} />
    </>
  )}

  <!-- Theme script (Prevent layout shift / flash) -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('sniptools-theme');
      if (saved === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      }
    })();
  </script>
</head>
<body class="bg-bg-primary text-text-primary relative selection:bg-accent/30 selection:text-white">
  <!-- Ambient background glow effect -->
  <div class="ambient-glow" aria-hidden="true"></div>

  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[9999] focus:bg-accent focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
    Skip to main content
  </a>

  <Header />
  <CommandPalette />

  <main id="main-content" class="min-h-[calc(100vh-140px)] relative z-10">
    <slot />
  </main>

  <Footer />
  <ToastContainer />

  <!-- Global JavaScript Utilities -->
  <script is:inline>
    // Global Theme Switcher
    window.toggleTheme = function() {
      const html = document.documentElement;
      const isLight = html.classList.contains('light');
      if (isLight) {
        html.classList.remove('light');
        html.classList.add('dark');
        localStorage.setItem('sniptools-theme', 'dark');
      } else {
        html.classList.remove('dark');
        html.classList.add('light');
        localStorage.setItem('sniptools-theme', 'light');
      }
    };

    // Toast Popup Notifications
    window.showToast = function(message, type = 'success', duration = 2800) {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      const icons = { success: '✓', error: '✕', info: 'ℹ' };
      toast.innerHTML = `<span class="font-bold">${icons[type] || '•'}</span><span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        toast.style.transition = 'all 0.25s ease';
        setTimeout(() => toast.remove(), 250);
      }, duration);
    };

    // Copy to Clipboard
    window.copyToClipboard = async function(text, label = 'Copied to clipboard!') {
      if (!text) {
        window.showToast('Nothing to copy!', 'info');
        return false;
      }
      try {
        await navigator.clipboard.writeText(text);
        window.showToast(label, 'success');
        return true;
      } catch (err) {
        window.showToast('Failed to copy', 'error');
        return false;
      }
    };
  </script>
</body>
</html>
