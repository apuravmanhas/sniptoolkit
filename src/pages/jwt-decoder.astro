---
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "JWT Decoder & Inspector",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All",
      "url": "https://sniptoolkit.com/jwt-decoder",
      "description": "Decode, inspect, and verify JWT (JSON Web Tokens) online instantly. 100% secure client-side decoding with no server uploads.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a JWT decoder?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A JWT decoder is a tool that takes a JSON Web Token (which looks like a long string of random characters separated by two dots) and translates the Base64Url encoded segments back into readable JSON. It allows you to see the Header (algorithm used) and Payload (claims/data) hidden inside the token."
          }
        },
        {
          "@type": "Question",
          "name": "Can I decode a JWT online?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! You can securely decode JWTs online using SnipToolkit's JWT Decoder. Our tool operates 100% locally in your browser using JavaScript. Your token is never uploaded or sent to any backend server, ensuring complete privacy."
          }
        },
        {
          "@type": "Question",
          "name": "Is JWT decode safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Decoding a JWT simply translates the Base64 encoding into readable text. Doing this locally in your browser (like on this site) is 100% safe. However, you should never paste a sensitive JWT (like a production access token) into a decoder that uploads data to a remote server."
          }
        },
        {
          "@type": "Question",
          "name": "Can you decode JWT without a secret?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, you can easily decode the Header and Payload of a JWT without the secret key, because those parts are only Base64Url encoded, not encrypted. However, you cannot *verify* the signature or ensure the token hasn't been tampered with without the secret key."
          }
        },
        {
          "@type": "Question",
          "name": "What is JWT used for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "JWT (JSON Web Token) is commonly used for authorization and information exchange. When a user logs in, the server generates a JWT containing their user ID and roles, signs it securely, and sends it to the client. The client then sends this token with every subsequent HTTP request to access protected routes."
          }
        },
        {
          "@type": "Question",
          "name": "How to install JWT decode?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You do not need to install any software to decode a JWT. You can simply paste your token into our online web tool. If you are developing an app, you can install libraries like `jsonwebtoken` for Node.js or `jwt-decode` for client-side JavaScript via npm."
          }
        },
        {
          "@type": "Question",
          "name": "Is JWT an OAuth token?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not exactly. OAuth is an authorization protocol, while JWT is a token format. However, OAuth 2.0 frequently uses JWTs as the format for its Access Tokens and ID Tokens."
          }
        },
        {
          "@type": "Question",
          "name": "Is JWT the same as JSON?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. JSON (JavaScript Object Notation) is a data format. A JWT is a specific standard (RFC 7519) that *uses* JSON inside of it to store data (claims), but the JSON is Base64Url encoded and accompanied by a cryptographic signature."
          }
        },
        {
          "@type": "Question",
          "name": "Can I use JWT in Python?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! You can use the `PyJWT` library in Python. Simply run `pip install PyJWT`. You can then decode a token using `jwt.decode(token, secret_key, algorithms=['HS256'])`."
          }
        }
      ]
    }
  ]
};

const relatedTools = [
  {
    name: 'Base64 Encode & Decode',
    slug: '/base64',
    icon: '⟨⟩',
    category: 'Encoding',
    description: 'Encode text or files to Base64 format and decode Base64 strings.'
  },
  {
    name: 'JSON Formatter & Validator',
    slug: '/json-formatter',
    icon: '{ }',
    category: 'Data',
    description: 'Format, validate, beautify, and minify JSON data instantly.'
  },
  {
    name: 'SHA & MD5 Generator',
    slug: '/hash-generator',
    icon: '🔒',
    category: 'Security',
    description: 'Generate MD5, SHA-1, SHA-256, and SHA-512 hashes instantly.'
  }
];
---

<BaseLayout
  title="JWT Decoder & Inspector Online — Free, 100% Client-Side | SnipToolkit"
  description="Decode, verify, and inspect JWT (JSON Web Tokens) online instantly. 100% secure client-side decoding. Validate signatures with no server uploads."
  canonicalUrl="https://sniptoolkit.com/jwt-decoder/"
  structuredData={structuredData}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    
    <!-- Header -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold uppercase tracking-wider mb-3">
        <span>🔒 Security & Authentication</span>
        <span>•</span>
        <span>Client-Side</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight mb-2">
        JWT Decoder & Inspector
      </h1>
      <p class="text-text-secondary text-sm sm:text-base max-w-3xl">
        Decode and inspect JSON Web Tokens (JWT) safely in your browser. Validate HS256 signatures in real-time. 100% private — your token is never uploaded to a server.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- LEFT COLUMN: Input -->
      <div class="space-y-6">
        <div class="p-6 rounded-2xl bg-bg-secondary border border-border-primary shadow-md">
          <div class="flex items-center justify-between mb-2">
            <label for="jwt-input" class="text-xs font-semibold text-text-secondary uppercase tracking-wider">
              Encoded Token
            </label>
            <button id="clear-btn" class="text-text-tertiary hover:text-red-400 font-sans cursor-pointer underline text-xs">Clear</button>
          </div>
          
          <!-- Colored Token Visualizer -->
          <div id="token-visualizer" class="w-full px-4 py-3 rounded-t-xl bg-bg-tertiary border border-border-secondary border-b-0 font-mono text-sm break-all min-h-[4rem] hidden">
            <!-- Populated via JS -->
          </div>

          <textarea
            id="jwt-input"
            rows="8"
            placeholder="Paste your JWT (JSON Web Token) here..."
            class="w-full px-4 py-3 rounded-b-xl rounded-t-xl bg-bg-tertiary border border-border-secondary focus:border-accent text-text-primary font-mono text-sm outline-none transition-all resize-y placeholder:text-text-tertiary"
          ></textarea>
        </div>

        <!-- Signature Verification Box -->
        <div class="p-6 rounded-2xl bg-bg-secondary border border-border-primary shadow-md">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-bold text-text-primary uppercase tracking-wider">Verify Signature (HS256)</h3>
            <span id="sig-status-badge" class="px-2 py-0.5 rounded text-xs font-bold bg-bg-tertiary text-text-tertiary border border-border-secondary">Awaiting Token</span>
          </div>
          <p class="text-xs text-text-tertiary mb-3">
            Enter your secret key below to cryptographically verify if the signature is valid. This happens entirely in your browser.
          </p>
          <input
            type="text"
            id="secret-input"
            placeholder="your-256-bit-secret"
            class="w-full px-4 py-2 rounded-xl bg-bg-tertiary border border-border-secondary focus:border-blue-500 text-blue-400 font-mono text-sm outline-none transition-all"
          />
        </div>
      </div>

      <!-- RIGHT COLUMN: Output -->
      <div class="space-y-6">
        
        <!-- HEADER OUTPUT -->
        <div class="p-6 rounded-2xl bg-bg-secondary border border-border-primary shadow-md border-t-4 border-t-red-500">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-red-400 uppercase tracking-wider">Header <span class="text-text-tertiary lowercase text-xs font-normal">Algorithm & Token Type</span></h3>
            <button class="copy-btn text-text-tertiary hover:text-text-primary transition-colors cursor-pointer" data-target="header-output" title="Copy Header JSON">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
          <div class="bg-bg-tertiary rounded-xl border border-border-secondary overflow-hidden">
            <pre><code id="header-output" class="block p-4 text-sm font-mono text-text-primary overflow-x-auto whitespace-pre-wrap break-all min-h-[4rem]">{}</code></pre>
          </div>
        </div>

        <!-- PAYLOAD OUTPUT -->
        <div class="p-6 rounded-2xl bg-bg-secondary border border-border-primary shadow-md border-t-4 border-t-purple-500">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-purple-400 uppercase tracking-wider">Payload <span class="text-text-tertiary lowercase text-xs font-normal">Data & Claims</span></h3>
            <button class="copy-btn text-text-tertiary hover:text-text-primary transition-colors cursor-pointer" data-target="payload-output" title="Copy Payload JSON">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
          <div class="bg-bg-tertiary rounded-xl border border-border-secondary overflow-hidden relative">
             <pre><code id="payload-output" class="block p-4 text-sm font-mono text-text-primary overflow-x-auto whitespace-pre-wrap break-all min-h-[10rem]">{}</code></pre>
          </div>
        </div>

      </div>

    </div>

    <!-- What is a JWT Section -->
    <section class="mt-16 mb-16 p-8 rounded-2xl bg-bg-secondary border border-border-primary">
      <h2 class="text-2xl font-bold text-text-primary mb-6">What is a JSON Web Token (JWT)?</h2>
      <div class="space-y-4 text-sm text-text-secondary leading-relaxed">
        <p>
          A JSON Web Token (JWT) is an open standard (RFC 7519) that defines a compact and self-contained way for securely transmitting information between parties as a JSON object. This information can be verified and trusted because it is digitally signed.
        </p>
        <p>
          JWTs are most commonly used for <strong>Authorization</strong>. Once a user is logged in, each subsequent request will include the JWT, allowing the user to access routes, services, and resources that are permitted with that token. Single Sign On (SSO) is a feature that widely uses JWT nowadays.
        </p>
        <p>
          A standard JWT consists of three parts separated by dots (<code>.</code>):
        </p>
        <ul class="list-disc pl-6 space-y-2 mt-2">
          <li><strong class="text-red-400">Header:</strong> Typically consists of two parts: the type of the token, which is JWT, and the signing algorithm being used, such as HMAC SHA256 or RSA.</li>
          <li><strong class="text-purple-400">Payload:</strong> Contains the claims. Claims are statements about an entity (typically, the user) and additional data.</li>
          <li><strong class="text-blue-400">Signature:</strong> To create the signature part, you have to take the encoded header, the encoded payload, a secret, the algorithm specified in the header, and sign that.</li>
        </ul>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-16 p-8 rounded-2xl bg-bg-secondary border border-border-primary">
      <h2 class="text-2xl font-bold text-text-primary mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {structuredData['@graph'][1].mainEntity.map((faq) => (
          <div class="p-5 rounded-xl bg-bg-tertiary border border-border-primary">
            <h3 class="text-base font-semibold text-text-primary mb-2 flex items-center gap-2">
              <span class="text-accent font-bold">Q:</span> {faq.name}
            </h3>
            <p class="text-xs text-text-secondary leading-relaxed pl-6">
              {faq.acceptedAnswer.text}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Tools Section -->
    <section>
      <h2 class="text-xl font-bold text-text-primary mb-4">Related Developer Tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {relatedTools.map(tool => (
          <a
            href={tool.slug}
            class="p-4 rounded-xl bg-bg-secondary border border-border-primary hover:border-accent transition-all duration-200 no-underline group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-lg">{tool.icon}</span>
                <span class="text-xs font-semibold text-text-primary group-hover:text-accent transition-colors">{tool.name}</span>
              </div>
              <p class="text-xs text-text-secondary line-clamp-2">{tool.description}</p>
            </div>
            <span class="mt-3 text-[11px] font-semibold text-accent flex items-center gap-1">
              Try tool →
            </span>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const jwtInput = document.getElementById('jwt-input');
    const secretInput = document.getElementById('secret-input');
    const headerOutput = document.getElementById('header-output');
    const payloadOutput = document.getElementById('payload-output');
    const tokenVisualizer = document.getElementById('token-visualizer');
    const clearBtn = document.getElementById('clear-btn');
    const sigStatusBadge = document.getElementById('sig-status-badge');

    // Utility: Decode Base64Url string to UTF-8 text
    function base64UrlDecode(str) {
      try {
        // Convert Base64Url to Base64
        let base64 = str.replace(/-/g, '+').replace(/_/g, '/');
        // Pad with '='
        while (base64.length % 4) {
          base64 += '=';
        }
        // Decode Base64 to URI encoded string, then decode URI component
        return decodeURIComponent(
          atob(base64)
            .split('')
            .map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2))
            .join('')
        );
      } catch (e) {
        return null; // Invalid base64 or JSON
      }
    }

    // Utility: Convert string to Uint8Array
    function stringToUint8Array(str) {
      return new TextEncoder().encode(str);
    }

    // Utility: Format JSON beautifully
    function formatJson(jsonStr) {
      try {
        const obj = JSON.parse(jsonStr);
        return JSON.stringify(obj, null, 2);
      } catch (e) {
        return jsonStr; // return raw if parsing fails
      }
    }

    // Process the JWT input
    async function processJwt() {
      const token = jwtInput.value.trim();
      const secret = secretInput.value;

      if (!token) {
        resetUI();
        return;
      }

      const parts = token.split('.');
      
      if (parts.length !== 3) {
        // Invalid JWT format
        headerOutput.textContent = 'Invalid JWT format. Must contain 3 parts separated by dots.';
        headerOutput.className = 'block p-4 text-sm font-mono text-red-400 overflow-x-auto min-h-[4rem]';
        payloadOutput.textContent = '';
        tokenVisualizer.classList.add('hidden');
        jwtInput.classList.remove('rounded-t-none', 'border-t-0');
        jwtInput.classList.add('rounded-t-xl');
        updateSigBadge('Invalid Format', 'error');
        return;
      }

      const [headerB64, payloadB64, signatureB64] = parts;

      // Decode Header
      const headerRaw = base64UrlDecode(headerB64);
      if (headerRaw) {
        headerOutput.textContent = formatJson(headerRaw);
        headerOutput.className = 'block p-4 text-sm font-mono text-text-primary overflow-x-auto min-h-[4rem] whitespace-pre-wrap';
      } else {
        headerOutput.textContent = 'Failed to decode Header';
        headerOutput.className = 'block p-4 text-sm font-mono text-red-400 overflow-x-auto min-h-[4rem]';
      }

      // Decode Payload
      const payloadRaw = base64UrlDecode(payloadB64);
      if (payloadRaw) {
        payloadOutput.textContent = formatJson(payloadRaw);
        payloadOutput.className = 'block p-4 text-sm font-mono text-text-primary overflow-x-auto min-h-[10rem] whitespace-pre-wrap';
      } else {
        payloadOutput.textContent = 'Failed to decode Payload';
        payloadOutput.className = 'block p-4 text-sm font-mono text-red-400 overflow-x-auto min-h-[10rem]';
      }

      // Update Visualizer
      tokenVisualizer.classList.remove('hidden');
      jwtInput.classList.remove('rounded-t-xl');
      jwtInput.classList.add('rounded-t-none', 'border-t-0');
      
      tokenVisualizer.innerHTML = `
        <span class="text-red-400 font-bold">${headerB64}</span><span class="text-text-tertiary">.</span><span class="text-purple-400 font-bold">${payloadB64}</span><span class="text-text-tertiary">.</span><span class="text-blue-400 font-bold">${signatureB64}</span>
      `;

      // Verify Signature (HS256 only for now)
      if (headerRaw) {
        try {
          const headerObj = JSON.parse(headerRaw);
          if (headerObj.alg === 'HS256') {
            if (secret) {
              await verifyHS256(headerB64, payloadB64, signatureB64, secret);
            } else {
              updateSigBadge('Provide Secret', 'warning');
            }
          } else {
            updateSigBadge(`Unsupported Alg: ${headerObj.alg}`, 'warning');
          }
        } catch (e) {
          updateSigBadge('Error reading Header', 'error');
        }
      }
    }

    // Verify HS256 Signature using Web Crypto API
    async function verifyHS256(header, payload, signatureBase64Url, secret) {
      try {
        const keyData = stringToUint8Array(secret);
        const dataToSign = stringToUint8Array(`${header}.${payload}`);

        const cryptoKey = await crypto.subtle.importKey(
          'raw',
          keyData,
          { name: 'HMAC', hash: { name: 'SHA-256' } },
          false,
          ['sign']
        );

        const signatureBuffer = await crypto.subtle.sign('HMAC', cryptoKey, dataToSign);
        
        // Convert resulting buffer to Base64Url
        const signatureBytes = new Uint8Array(signatureBuffer);
        const signatureBase64 = btoa(String.fromCharCode.apply(null, signatureBytes));
        const expectedSignatureBase64Url = signatureBase64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');

        if (signatureBase64Url === expectedSignatureBase64Url) {
          updateSigBadge('Signature Verified', 'success');
        } else {
          updateSigBadge('Invalid Signature', 'error');
        }
      } catch (e) {
        console.error('Crypto Error:', e);
        updateSigBadge('Crypto Error', 'error');
      }
    }

    function updateSigBadge(text, state) {
      sigStatusBadge.textContent = text;
      sigStatusBadge.className = 'px-2 py-0.5 rounded text-xs font-bold';
      
      if (state === 'success') {
        sigStatusBadge.classList.add('bg-green-500/20', 'text-green-400', 'border', 'border-green-500/30');
      } else if (state === 'error') {
        sigStatusBadge.classList.add('bg-red-500/20', 'text-red-400', 'border', 'border-red-500/30');
      } else if (state === 'warning') {
        sigStatusBadge.classList.add('bg-yellow-500/20', 'text-yellow-400', 'border', 'border-yellow-500/30');
      } else {
        sigStatusBadge.classList.add('bg-bg-tertiary', 'text-text-tertiary', 'border', 'border-border-secondary');
      }
    }

    function resetUI() {
      headerOutput.textContent = '{}';
      payloadOutput.textContent = '{}';
      headerOutput.className = 'block p-4 text-sm font-mono text-text-primary overflow-x-auto min-h-[4rem]';
      payloadOutput.className = 'block p-4 text-sm font-mono text-text-primary overflow-x-auto min-h-[10rem]';
      tokenVisualizer.classList.add('hidden');
      jwtInput.classList.remove('rounded-t-none', 'border-t-0');
      jwtInput.classList.add('rounded-t-xl');
      updateSigBadge('Awaiting Token', 'default');
    }

    // Event Listeners
    jwtInput.addEventListener('input', processJwt);
    secretInput.addEventListener('input', processJwt);

    clearBtn.addEventListener('click', () => {
      jwtInput.value = '';
      secretInput.value = '';
      resetUI();
    });

    // Copy Buttons
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const content = document.getElementById(targetId)?.textContent;
        if (content && content !== '{}') {
          if (window.copyToClipboard) {
            window.copyToClipboard(content, 'Copied to clipboard!');
          } else {
            navigator.clipboard.writeText(content);
            alert('Copied!');
          }
        }
      });
    });
  });
</script>
