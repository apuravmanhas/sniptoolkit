---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us — SnipTools"
  description="Get in touch with the SnipTools team for feedback, feature requests, or bug reports."
>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="mb-10 text-center">
      <span class="inline-block px-3 py-1 text-xs font-semibold text-accent bg-accent/10 border border-accent/20 rounded-full mb-3">
        Feedback & Support
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight mb-3">Contact Us</h1>
      <p class="text-sm text-text-secondary">Have a feature request, bug report, or feedback? Drop us a message!</p>
    </div>

    <div class="rounded-2xl border border-border-primary bg-bg-secondary p-6 sm:p-8">
      <form id="contact-form" class="space-y-4" onsubmit="event.preventDefault(); window.showToast('Thank you! Your message has been submitted.', 'success'); this.reset();">
        <div>
          <label for="name" class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Name</label>
          <input
            type="text"
            id="name"
            required
            placeholder="Your name"
            class="w-full rounded-lg bg-bg-tertiary border border-border-primary px-3.5 py-2.5 text-sm text-text-primary placeholder-text-tertiary focus:border-accent focus:outline-none"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Email Address</label>
          <input
            type="email"
            id="email"
            required
            placeholder="you@example.com"
            class="w-full rounded-lg bg-bg-tertiary border border-border-primary px-3.5 py-2.5 text-sm text-text-primary placeholder-text-tertiary focus:border-accent focus:outline-none"
          />
        </div>

        <div>
          <label for="subject" class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Subject</label>
          <select
            id="subject"
            class="w-full rounded-lg bg-bg-tertiary border border-border-primary px-3.5 py-2.5 text-sm text-text-primary focus:border-accent focus:outline-none"
          >
            <option value="feature">Feature Request / New Tool Idea</option>
            <option value="bug">Bug Report</option>
            <option value="feedback">General Feedback</option>
            <option value="other">Other Inquiry</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Message</label>
          <textarea
            id="message"
            rows="5"
            required
            placeholder="Tell us what tool you'd like us to add or describe any bug..."
            class="w-full rounded-lg bg-bg-tertiary border border-border-primary px-3.5 py-2.5 text-sm text-text-primary placeholder-text-tertiary focus:border-accent focus:outline-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 px-4 rounded-xl bg-accent hover:bg-accent-hover text-white text-sm font-semibold shadow-lg shadow-accent/25 transition-all duration-200 cursor-pointer"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</BaseLayout>
