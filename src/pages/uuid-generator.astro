---
import BaseLayout from '../layouts/BaseLayout.astro';

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "UUID / GUID Generator",
  "operatingSystem": "All",
  "applicationCategory": "DeveloperApplication",
  "url": "https://sniptoolkit.com/uuid-generator",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free online UUID and GUID generator supporting v4 random and v7 time-ordered UUIDs in bulk up to 500 records."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between UUID v4 and UUID v7?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "UUID v4 is generated using cryptographically strong random numbers (122 random bits), offering maximum randomness but poor database index locality. UUID v7 combines a 48-bit millisecond timestamp with random bits, making it time-ordered, sortable, and optimized for database primary keys (B-tree indexing)."
      }
    },
    {
      "@type": "Question",
      "name": "Are UUIDs generated on SnipTools secure and private?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, 100%. All UUIDs are generated locally in your web browser using Web Cryptography API (crypto.getRandomValues and crypto.randomUUID). Your generated keys never leave your machine and are not sent to any backend server."
      }
    },
    {
      "@type": "Question",
      "name": "Can two generated UUID v4 values collide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The probability of a collision in UUID v4 is astronomically small. You would need to generate 1 billion UUIDs every second for 85 years to have a 50% chance of a single collision."
      }
    },
    {
      "@type": "Question",
      "name": "How many UUIDs can I generate at once in bulk?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can bulk generate anywhere from 1 to 500 UUIDs instantly. You can format them with uppercase letters, hyphens, or curly braces, and download the entire batch as a .txt file."
      }
    }
  ]
};

const combinedSchema = [softwareSchema, faqSchema];

const relatedTools = [
  {
    name: 'URL Encode & Decode',
    slug: '/url-encode-decode',
    icon: '%',
    category: 'Encoding',
    description: 'Safely encode special characters for URLs or decode percent-encoded query strings.'
  },
  {
    name: 'Base64 Encode & Decode',
    slug: '/base64',
    icon: '⟨⟩',
    category: 'Encoding',
    description: 'Encode text or files to Base64 format and decode Base64 strings back to original format.'
  },
  {
    name: 'Hash Generator',
    slug: '/hash-generator',
    icon: '🔒',
    category: 'Security',
    description: 'Generate secure cryptographic hashes including MD5, SHA-1, SHA-256, and SHA-512.'
  },
  {
    name: 'JSON Formatter',
    slug: '/json-formatter',
    icon: '{ }',
    category: 'Data',
    description: 'Format, validate, beautify, and minify JSON data instantly with line error highlighting.'
  }
];
---

