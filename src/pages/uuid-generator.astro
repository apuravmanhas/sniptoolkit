</BaseLayout>

<script is:inline>
  // State
  let currentVersion = 'v4';
  let quantity = 1;
  let options = {
    uppercase: false,
    hyphens: true,
    braces: false
  };
  let generatedList = [];

  // DOM Elements
  const btnV4 = document.getElementById('btn-version-v4');
  const btnV7 = document.getElementById('btn-version-v7');
  const qtyInput = document.getElementById('quantity-input');
  const qtyBadge = document.getElementById('qty-badge');
  const toggleUppercase = document.getElementById('toggle-uppercase');
  const toggleHyphens = document.getElementById('toggle-hyphens');
  const toggleBraces = document.getElementById('toggle-braces');
  const btnGenerate = document.getElementById('btn-generate');
  const btnCopyAll = document.getElementById('btn-copy-all');
  const btnDownload = document.getElementById('btn-download');
  const btnCopyPrimary = document.getElementById('btn-copy-primary');
  const primaryText = document.getElementById('primary-uuid-text');
  const primaryVerBadge = document.getElementById('primary-ver-badge');
  const outputTextarea = document.getElementById('uuid-output-textarea');
  const outputCountLabel = document.getElementById('output-count-label');

  // Generator algorithms
  function generateV4() {
    if (typeof crypto !== 'undefined' && crypto.randomUUID) {
      return crypto.randomUUID();
    }
    const bytes = new Uint8Array(16);
    crypto.getRandomValues(bytes);
    bytes[6] = (bytes[6] & 0x0f) | 0x40; // Version 4
    bytes[8] = (bytes[8] & 0x3f) | 0x80; // Variant 1
    const hex = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`;
  }

  function generateV7() {
    const now = Date.now();
    const timeHex = now.toString(16).padStart(12, '0');
    const bytes = new Uint8Array(16);
    crypto.getRandomValues(bytes);

    for (let i = 0; i < 6; i++) {
      bytes[i] = parseInt(timeHex.slice(i * 2, i * 2 + 2), 16);
    }
    bytes[6] = (bytes[6] & 0x0f) | 0x70; // Version 7
    bytes[8] = (bytes[8] & 0x3f) | 0x80; // Variant 1

    const hex = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`;
  }

  function formatSingle(rawUuid) {
    let str = rawUuid;
    if (!options.hyphens) {
      str = str.replace(/-/g, '');
    }
    if (options.uppercase) {
      str = str.toUpperCase();
    } else {
      str = str.toLowerCase();
    }
    if (options.braces) {
      str = `{${str}}`;
    }
    return str;
  }

  function updateGeneration() {
    generatedList = [];
    const count = Math.min(Math.max(parseInt(qtyInput.value) || 1, 1), 500);
    quantity = count;
    qtyInput.value = count;
    qtyBadge.textContent = count === 1 ? '1 item' : `${count} items`;
    outputCountLabel.textContent = count;

    for (let i = 0; i < count; i++) {
      const raw = currentVersion === 'v7' ? generateV7() : generateV4();
      generatedList.push(formatSingle(raw));
    }

    // Render primary
    primaryText.textContent = generatedList[0];
    primaryVerBadge.textContent = currentVersion;

    // Render bulk textarea
    outputTextarea.value = generatedList.join('\n');
    outputTextarea.rows = Math.min(Math.max(count, 4), 16);
  }

  // Version Buttons
  btnV4.addEventListener('click', () => {
    currentVersion = 'v4';
    btnV4.classList.add('active', 'bg-bg-secondary', 'text-text-primary', 'border', 'border-border-secondary', 'shadow-sm', 'font-semibold');
    btnV4.classList.remove('text-text-secondary', 'font-medium');
    btnV7.classList.remove('active', 'bg-bg-secondary', 'text-text-primary', 'border', 'border-border-secondary', 'shadow-sm', 'font-semibold');
    btnV7.classList.add('text-text-secondary', 'font-medium');
    updateGeneration();
  });

  btnV7.addEventListener('click', () => {
    currentVersion = 'v7';
    btnV7.classList.add('active', 'bg-bg-secondary', 'text-text-primary', 'border', 'border-border-secondary', 'shadow-sm', 'font-semibold');
    btnV7.classList.remove('text-text-secondary', 'font-medium');
    btnV4.classList.remove('active', 'bg-bg-secondary', 'text-text-primary', 'border', 'border-border-secondary', 'shadow-sm', 'font-semibold');
    btnV4.classList.add('text-text-secondary', 'font-medium');
    updateGeneration();
  });

  // Quantity Presets
  document.querySelectorAll('.qty-preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const q = parseInt(btn.getAttribute('data-qty'));
      qtyInput.value = q;
      updateGeneration();
    });
  });

  qtyInput.addEventListener('input', () => {
    updateGeneration();
  });

  // Formatting Toggles
  toggleUppercase.addEventListener('change', (e) => {
    options.uppercase = e.target.checked;
    updateGeneration();
  });

  toggleHyphens.addEventListener('change', (e) => {
    options.hyphens = e.target.checked;
    updateGeneration();
  });

  toggleBraces.addEventListener('change', (e) => {
    options.braces = e.target.checked;
    updateGeneration();
  });

  // Action listeners
  btnGenerate.addEventListener('click', () => {
    updateGeneration();
    if (window.showToast) window.showToast(`Generated ${quantity} new ${currentVersion.toUpperCase()} UUID(s)`, 'success');
  });

  btnCopyPrimary.addEventListener('click', () => {
    if (generatedList[0] && window.copyToClipboard) {
      window.copyToClipboard(generatedList[0], 'UUID copied to clipboard!');
    }
  });

  btnCopyAll.addEventListener('click', () => {
    if (generatedList.length > 0 && window.copyToClipboard) {
      const text = generatedList.join('\n');
      window.copyToClipboard(text, `Copied ${generatedList.length} UUID(s) to clipboard!`);
    }
  });

  btnDownload.addEventListener('click', () => {
    if (generatedList.length === 0) return;
    const text = generatedList.join('\n');
    const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `uuids-${currentVersion}-${Date.now()}.txt`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    if (window.showToast) window.showToast('Downloaded TXT file!', 'success');
  });

  // Keyboard shortcut: Space key regenerates UUIDs
  document.addEventListener('keydown', (e) => {
    if (['INPUT', 'TEXTAREA', 'BUTTON', 'SELECT'].includes(document.activeElement?.tagName)) return;
    if (e.code === 'Space') {
      e.preventDefault();
      updateGeneration();
      if (window.showToast) window.showToast(`Regenerated ${quantity} ${currentVersion.toUpperCase()} UUID(s)`, 'success');
    }
  });

  // Initial generation
  updateGeneration();
</script>
