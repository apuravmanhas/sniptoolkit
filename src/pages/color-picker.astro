                Copy HSV
              </button>
            </div>
          </div>

          <!-- RGB Components Sliders -->
          <div class="pt-4 border-t border-border-primary space-y-3">
            <span class="text-xs font-bold text-text-secondary block">RGB Channel Sliders</span>

            <!-- Red slider -->
            <div class="flex items-center gap-3 text-xs font-mono">
