                class="px-4 py-2.5 rounded-xl bg-accent text-white font-semibold text-xs hover:bg-accent-hover transition-colors flex items-center gap-1.5"
              >
                Copy HEX
              </button>
            </div>
          </div>

          <!-- RGB Input -->
          <div class="space-y-1.5">
            <label for="input-rgb" class="flex justify-between text-xs font-bold text-text-secondary">
              <span>RGB Color Format</span>
              <span class="font-mono text-text-tertiary text-[11px]">rgb(R, G, B)</span>
            </label>
            <div class="flex gap-2">
              <input
                type="text"
                id="input-rgb"
                value="rgb(59, 130, 246)"
                class="flex-1 rounded-xl bg-bg-tertiary border border-border-primary px-3.5 py-2.5 text-sm font-mono text-text-primary focus:border-accent focus:outline-none transition-all"
              />
              <button
                id="btn-copy-rgb"
                class="px-4 py-2.5 rounded-xl bg-bg-tertiary border border-border-primary hover:border-accent text-text-primary font-medium text-xs transition-colors"
              >
                Copy RGB
              </button>
            </div>
          </div>

          <!-- HSL Input -->
          <div class="space-y-1.5">
            <label for="input-hsl" class="flex justify-between text-xs font-bold text-text-secondary">
              <span>HSL Color Format</span>
              <span class="font-mono text-text-tertiary text-[11px]">hsl(H, S%, L%)</span>
            </label>
            <div class="flex gap-2">
              <input
                type="text"
                id="input-hsl"
                value="hsl(217, 91%, 60%)"
                class="flex-1 rounded-xl bg-bg-tertiary border border-border-primary px-3.5 py-2.5 text-sm font-mono text-text-primary focus:border-accent focus:outline-none transition-all"
              />
              <button
                id="btn-copy-hsl"
                class="px-4 py-2.5 rounded-xl bg-bg-tertiary border border-border-primary hover:border-accent text-text-primary font-medium text-xs transition-colors"
