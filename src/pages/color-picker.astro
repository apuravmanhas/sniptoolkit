          <p class="text-xs text-text-tertiary -mt-3 mb-4">Edit any field to dynamically update all color formats in real time.</p>

          <!-- HEX Input -->
          <div class="space-y-1.5">
            <label for="input-hex" class="flex justify-between text-xs font-bold text-text-secondary">
              <span>HEX Color Code</span>
              <span class="font-mono text-text-tertiary text-[11px]">#RRGGBB</span>
            </label>
            <div class="flex gap-2">
              <div class="relative flex-1">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-text-tertiary font-mono text-sm">#</span>
