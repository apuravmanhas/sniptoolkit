---
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Color Picker & Converter",
    "operatingSystem": "All",
    "applicationCategory": "DeveloperApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "Free online color picker and converter. Two-way sync between HEX, RGB, HSL, HSV formats, WCAG contrast ratio checker, and preset swatches."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What color formats does this converter support?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "This tool supports two-way live conversion between HEX (#RRGGBB), RGB (Red, Green, Blue), HSL (Hue, Saturation, Lightness), and HSV (Hue, Saturation, Value)."
        }
      },
      {
        "@type": "Question",
        "name": "How is WCAG contrast ratio calculated?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The Web Content Accessibility Guidelines (WCAG) contrast ratio is calculated using relative luminance values derived from sRGB components. Normal text requires at least 4.5:1 for AA and 7:1 for AAA compliance."
        }
      },
      {
        "@type": "Question",
        "name": "Can I pick colors directly from my screen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! Clicking the native color input or Eyedropper icon opens your operating system's native color picker eyedropper tool."
        }
      }
    ]
  }
];

const faqs = [
  {
    question: "What color formats does this converter support?",
    answer: "This tool supports two-way live conversion between HEX (#RRGGBB), RGB (Red, Green, Blue), HSL (Hue, Saturation, Lightness), and HSV (Hue, Saturation, Value)."
  },
  {
    question: "How is WCAG contrast ratio calculated?",
    answer: "The WCAG contrast ratio is calculated using relative luminance values derived from sRGB components. Normal text requires at least 4.5:1 for AA and 7:1 for AAA compliance."
  },
  {
    question: "Can I pick colors directly from my screen?",
    answer: "Yes! Modern web browsers support the native EyeDropper API via the color picker input, allowing you to sample any color on your monitor."
  }
];

const presetPalettes = [
  { name: 'Vercel Blue', hex: '#0070f3' },
  { name: 'Tailwind Sky', hex: '#0ea5e9' },
  { name: 'Emerald Green', hex: '#10b981' },
  { name: 'Amber Warning', hex: '#f59e0b' },
  { name: 'Rose Red', hex: '#f43f5e' },
  { name: 'Purple Vivid', hex: '#8b5cf6' },
  { name: 'Fuchsia Pink', hex: '#d946ef' },
  { name: 'Dark Slate', hex: '#0f172a' },
  { name: 'Neutral Gray', hex: '#737373' },
  { name: 'Pure White', hex: '#ffffff' }
];

const relatedTools = [
  {
    name: 'Word & Character Counter',
    slug: '/word-counter',
    icon: 'Aa',
    category: 'Text',
    description: 'Count words, characters, sentences, paragraphs, and estimate reading time.'
  },
  {
    name: 'Lorem Ipsum Generator',
    slug: '/lorem-ipsum',
    icon: '¶',
    category: 'Generator',
    description: 'Generate placeholder text, paragraphs, words, or lists for UI designs.'
  },
  {
    name: 'Base64 Encode & Decode',
    slug: '/base64',
    icon: '⟨⟩',
    category: 'Encoding',
    description: 'Encode text or files to Base64 format and decode Base64 strings back.'
  }
];
---

<BaseLayout
  title="Color Picker & Converter — HEX, RGB, HSL, HSV & Contrast Checker | SnipTools"
  description="Free online interactive color picker and converter. Convert HEX, RGB, HSL, and HSV with live two-way sync, WCAG color contrast checker, and swatches."
  structuredData={structuredData}
  canonicalUrl="https://sniptoolkit.com/color-picker"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10 md:py-14">
    <!-- Header -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold text-accent bg-accent/10 border border-accent/20 mb-3">
        <span>🎨</span>
        <span>Design & CSS Utility</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-text-primary tracking-tight mb-3">
        Color Picker & Converter
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-2xl mx-auto">
        Convert color codes seamlessly across HEX, RGB, HSL, and HSV formats with instant WCAG contrast ratio verification.
      </p>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left Column: Visual Preview & Picker -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Main Color Preview Card -->
        <div class="rounded-2xl border border-border-primary bg-bg-secondary p-5 shadow-xl space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-text-secondary uppercase tracking-wider">Color Preview</span>
            <button
              id="btn-random"
              class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-bg-tertiary text-text-primary hover:bg-bg-hover border border-border-primary transition-all cursor-pointer flex items-center gap-1.5"
              title="Generate random color (Press R or Space)"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
              <span>Random Color</span>
            </button>
          </div>

          <!-- Preview Box with Text Contrast Preview -->
          <div
            id="color-preview-box"
            class="w-full h-44 rounded-xl shadow-inner border border-white/10 flex flex-col items-center justify-center p-4 transition-colors duration-200"
            style="background-color: #3b82f6;"
          >
            <!-- White text sample -->
            <div class="text-white text-center drop-shadow">
              <span class="text-lg font-bold block" id="preview-hex-display">#3B82F6</span>
              <span class="text-xs opacity-90">White Text Preview</span>
            </div>

            <div class="w-24 h-px bg-white/20 my-2"></div>

            <!-- Black text sample -->
            <div class="text-black text-center">
              <span class="text-xs font-medium opacity-90">Black Text Preview</span>
            </div>
          </div>

          <!-- Color Picker Trigger Input -->
          <div class="flex items-center gap-3">
            <label for="native-color-picker" class="flex-1 flex items-center gap-3 p-3 rounded-xl bg-bg-tertiary border border-border-primary hover:border-accent cursor-pointer transition-colors">
              <input
                type="color"
                id="native-color-picker"
                value="#3b82f6"
                class="w-8 h-8 rounded border-0 bg-transparent cursor-pointer"
              />
              <div class="flex flex-col">
                <span class="text-xs font-bold text-text-primary">Native Color Picker</span>
                <span class="text-[11px] text-text-tertiary">Click to open eyedropper</span>
              </div>
            </label>
          </div>
        </div>

        <!-- WCAG Accessibility Contrast Checker -->
        <div class="rounded-2xl border border-border-primary bg-bg-secondary p-5 shadow-xl space-y-4">
          <h2 class="text-sm font-bold text-text-primary flex items-center justify-between">
            <span>WCAG Contrast Ratio</span>
            <span class="text-xs font-normal text-text-tertiary">Standard 4.5:1</span>
          </h2>

          <div class="grid grid-cols-2 gap-3">
            <!-- White Background Contrast -->
            <div class="p-3.5 rounded-xl bg-bg-tertiary border border-border-primary space-y-2">
