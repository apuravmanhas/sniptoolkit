              </div>

              <div class="flex flex-wrap gap-1" id="contrast-white-badges">
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-success/20 text-success border border-success/30">AA Pass</span>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-error/20 text-error border border-error/30">AAA Fail</span>
              </div>
            </div>

            <!-- Black Background Contrast -->
            <div class="p-3.5 rounded-xl bg-bg-tertiary border border-border-primary space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs text-text-secondary font-medium">Vs. Black (#000)</span>
                <span id="contrast-black-ratio" class="font-mono text-sm font-bold text-text-primary">4.4:1</span>
              </div>

