      <h2 class="text-lg font-bold text-text-primary flex items-center justify-between">
        <span>Generated Cryptographic Hashes</span>
        <span id="hmac-active-badge" class="text-xs font-mono px-2 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/30 hidden">
          HMAC Active
        </span>
      </h2>

      <!-- MD5 Card -->
      <div class="p-4 rounded-xl bg-bg-secondary border border-border-primary shadow-sm hover:border-border-secondary transition-colors">
