            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy</span>
          </button>
        </div>
        <div id="hash-md5" class="font-mono text-sm text-text-primary break-all selection:bg-accent/30 selection:text-white">
          d41d8cd98f00b204e9800998ecf8427e
        </div>
      </div>

      <!-- SHA-1 Card -->
      <div class="p-4 rounded-xl bg-bg-secondary border border-border-primary shadow-sm hover:border-border-secondary transition-colors">
        <div class="flex items-center justify-between mb-1.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold font-mono uppercase px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">SHA-1</span>
            <span class="text-[11px] text-text-tertiary">160-bit digest</span>
          </div>
