            <button id="remove-file-btn" class="text-text-tertiary hover:text-red-400 text-xs px-2 py-1 rounded bg-bg-hover cursor-pointer">
              Remove
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- GENERATED HASH OUTPUTS (Simultaneous Results Grid) -->
