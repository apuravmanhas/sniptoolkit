        </div>
      </div>
    </div>

    <!-- How to Use Section -->
    <section class="mt-16 mb-16 p-8 rounded-2xl bg-bg-secondary border border-border-primary">
      <h2 class="text-2xl font-bold text-text-primary mb-6 flex items-center gap-2">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        How to Use the Online Hash Generator
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-5 rounded-xl bg-bg-tertiary border border-border-primary">
          <div class="w-8 h-8 rounded-lg bg-accent/20 text-accent font-bold flex items-center justify-center mb-3">1</div>
          <h3 class="font-semibold text-text-primary mb-2 text-base">Text or File Hashing</h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Choose whether to hash plain text or upload a local file (up to 100MB). Hashes are generated instantly as you type or drop a file.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-bg-tertiary border border-border-primary">
          <div class="w-8 h-8 rounded-lg bg-purple/20 text-purple font-bold flex items-center justify-center mb-3">2</div>
          <h3 class="font-semibold text-text-primary mb-2 text-base">Enable HMAC Secret Key</h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Check "Enable HMAC Mode" to calculate keyed-hash message authentication codes (HMAC-SHA256, HMAC-MD5, etc.) for API signature verification.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-bg-tertiary border border-border-primary">
          <div class="w-8 h-8 rounded-lg bg-success/20 text-success font-bold flex items-center justify-center mb-3">3</div>
          <h3 class="font-semibold text-text-primary mb-2 text-base">Toggle Case & Copy</h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Use the Lowercase/Uppercase toggle to match your API requirements. Click "Copy" next to any hash or "Copy All Hashes" for full summary export.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-16 p-8 rounded-2xl bg-bg-secondary border border-border-primary">
      <h2 class="text-2xl font-bold text-text-primary mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {structuredData['@graph'][1].mainEntity.map((faq) => (
          <div class="p-5 rounded-xl bg-bg-tertiary border border-border-primary">
            <h3 class="text-base font-semibold text-text-primary mb-2 flex items-center gap-2">
              <span class="text-accent font-bold">Q:</span> {faq.name}
            </h3>
            <p class="text-xs text-text-secondary leading-relaxed pl-6">
              {faq.acceptedAnswer.text}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Tools Section -->
    <section>
      <h2 class="text-xl font-bold text-text-primary mb-4">Related Developer Tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {relatedTools.map(tool => (
          <a
            href={tool.slug}
            class="p-4 rounded-xl bg-bg-secondary border border-border-primary hover:border-accent transition-all duration-200 no-underline group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center gap-2 mb-2">
                <span class="text-lg">{tool.icon}</span>
                <span class="text-xs font-semibold text-text-primary group-hover:text-accent transition-colors">{tool.name}</span>
              </div>
              <p class="text-xs text-text-secondary line-clamp-2">{tool.description}</p>
            </div>
            <span class="mt-3 text-[11px] font-semibold text-accent flex items-center gap-1">
              Try tool →
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  // --- Client-Side Cryptography Implementations ---

  // Standard UTF-8 / Uint8Array MD5 Implementation (RFC 1321)
  function md5Uint8Array(bytes) {
    const k = [
      0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
