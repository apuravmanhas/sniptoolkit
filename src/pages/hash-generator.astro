            <span>Copy SHA-256</span>
          </button>
        </div>
        <div id="hash-sha256" class="font-mono text-sm sm:text-base font-bold text-text-primary break-all selection:bg-accent/30 selection:text-white">
          e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
