      5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,  5,  9, 14, 20,
      4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,  4, 11, 16, 23,
      6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21,  6, 10, 15, 21
    ];

    let len = bytes.length;
    let bitLen = len * 8;
    let paddedLen = ((len + 8) >> 6) + 1 << 6;
    let padded = new Uint8Array(paddedLen);
    padded.set(bytes);
    padded[len] = 0x80;

    let view = new DataView(padded.buffer);
    view.setUint32(paddedLen - 8, bitLen & 0xffffffff, true);
    view.setUint32(paddedLen - 4, Math.floor(bitLen / 0x100000000), true);

    let a0 = 0x67452301, b0 = 0xefcdab89, c0 = 0x98badcfe, d0 = 0x10325476;

    for (let offset = 0; offset < paddedLen; offset += 64) {
      let M = new Uint32Array(16);
      for (let j = 0; j < 16; j++) {
        M[j] = view.getUint32(offset + j * 4, true);
      }

      let A = a0, B = b0, C = c0, D = d0;
      for (let i = 0; i < 64; i++) {
        let F, g;
        if (i < 16) { F = (B & C) | ((~B) & D); g = i; }
        else if (i < 32) { F = (D & B) | ((~D) & C); g = (5 * i + 1) % 16; }
        else if (i < 48) { F = B ^ C ^ D; g = (3 * i + 5) % 16; }
        else { F = C ^ (B | (~D)); g = (7 * i) % 16; }

        let temp = D;
        D = C;
        C = B;
        let sum = (A + F + k[i] + M[g]) >>> 0;
        let rot = (sum << s[i]) | (sum >>> (32 - s[i]));
        B = (B + rot) >>> 0;
        A = temp;
      }
      a0 = (a0 + A) >>> 0;
      b0 = (b0 + B) >>> 0;
      c0 = (c0 + C) >>> 0;
      d0 = (d0 + D) >>> 0;
    }

    let out = new Uint8Array(16);
    let outView = new DataView(out.buffer);
    outView.setUint32(0, a0, true);
    outView.setUint32(4, b0, true);
    outView.setUint32(8, c0, true);
    outView.setUint32(12, d0, true);
    return Array.from(out).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  // Web Crypto API for SHA-1, SHA-256, SHA-512
  async function hashSubtle(algorithm, dataBytes) {
    const hashBuffer = await crypto.subtle.digest(algorithm, dataBytes);
    return Array.from(new Uint8Array(hashBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  // HMAC SHA via Web Crypto API
  async function hmacSubtle(algorithm, keyBytes, dataBytes) {
    const key = await crypto.subtle.importKey(
      'raw',
      keyBytes,
      { name: 'HMAC', hash: { name: algorithm } },
      false,
      ['sign']
    );
    const signature = await crypto.subtle.sign('HMAC', key, dataBytes);
    return Array.from(new Uint8Array(signature)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  // HMAC-MD5 (RFC 2104)
  function hmacMd5(keyBytes, dataBytes) {
    let blockKey = new Uint8Array(64);
    if (keyBytes.length > 64) {
      let kMd5Hex = md5Uint8Array(keyBytes);
      for (let i = 0; i < 16; i++) {
        blockKey[i] = parseInt(kMd5Hex.substring(i * 2, i * 2 + 2), 16);
      }
    } else {
      blockKey.set(keyBytes);
    }
    let ipad = new Uint8Array(64);
    let opad = new Uint8Array(64);
    for (let i = 0; i < 64; i++) {
      ipad[i] = blockKey[i] ^ 0x36;
      opad[i] = blockKey[i] ^ 0x5c;
    }
    let innerData = new Uint8Array(64 + dataBytes.length);
    innerData.set(ipad, 0);
    innerData.set(dataBytes, 64);
    let innerHashHex = md5Uint8Array(innerData);

    let innerHashBytes = new Uint8Array(16);
    for (let i = 0; i < 16; i++) {
      innerHashBytes[i] = parseInt(innerHashHex.substring(i * 2, i * 2 + 2), 16);
    }

    let outerData = new Uint8Array(64 + 16);
    outerData.set(opad, 0);
    outerData.set(innerHashBytes, 64);
    return md5Uint8Array(outerData);
  }

  // --- UI Controller ---
  document.addEventListener('DOMContentLoaded', () => {
    let isUppercase = false;
    let isFileMode = false;
    let currentFileBytes = null;

    const tabTextBtn = document.getElementById('tab-text-btn');
    const tabFileBtn = document.getElementById('tab-file-btn');
    const panelTextMode = document.getElementById('panel-text-mode');
    const panelFileMode = document.getElementById('panel-file-mode');

    const textInput = document.getElementById('text-input');
    const clearTextBtn = document.getElementById('clear-text-btn');
    const statCharCount = document.getElementById('stat-char-count');
    const statByteCount = document.getElementById('stat-byte-count');

    const enableHmacCheckbox = document.getElementById('enable-hmac-checkbox');
    const hmacKeyContainer = document.getElementById('hmac-key-container');
    const hmacSecretInput = document.getElementById('hmac-secret-input');
    const hmacActiveBadge = document.getElementById('hmac-active-badge');

    const toggleCaseBtn = document.getElementById('toggle-case-btn');
    const caseStatusLabel = document.getElementById('case-status-label');

    const dropzone = document.getElementById('dropzone');
    const fileInput = document.getElementById('file-input');
    const fileInfoBanner = document.getElementById('file-info-banner');
    const fileNameEl = document.getElementById('file-name');
    const fileSizeEl = document.getElementById('file-size');
    const fileTypeEl = document.getElementById('file-type');
    const fileCalcStatus = document.getElementById('file-calc-status');
    const removeFileBtn = document.getElementById('remove-file-btn');

    const outMd5 = document.getElementById('hash-md5');
    const outSha1 = document.getElementById('hash-sha1');
    const outSha256 = document.getElementById('hash-sha256');
    const outSha512 = document.getElementById('hash-sha512');

    // --- Mode Tab Switching ---
    tabTextBtn?.addEventListener('click', () => {
      isFileMode = false;
      tabTextBtn.className = 'px-4 py-2 text-xs font-bold rounded-lg bg-bg-tertiary text-text-primary transition-all cursor-pointer flex items-center gap-2';
      tabFileBtn.className = 'px-4 py-2 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer flex items-center gap-2';
      panelTextMode.classList.remove('hidden');
      panelFileMode.classList.add('hidden');
      computeHashes();
    });

    tabFileBtn?.addEventListener('click', () => {
      isFileMode = true;
      tabFileBtn.className = 'px-4 py-2 text-xs font-bold rounded-lg bg-bg-tertiary text-text-primary transition-all cursor-pointer flex items-center gap-2';
      tabTextBtn.className = 'px-4 py-2 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer flex items-center gap-2';
      panelFileMode.classList.remove('hidden');
      panelTextMode.classList.add('hidden');
      if (currentFileBytes) computeHashes();
    });

    // --- Case Toggle ---
    toggleCaseBtn?.addEventListener('click', () => {
      isUppercase = !isUppercase;
      if (caseStatusLabel) caseStatusLabel.textContent = isUppercase ? 'Uppercase' : 'Lowercase';
      applyCaseFormat();
    });

    function applyCaseFormat() {
      [outMd5, outSha1, outSha256, outSha512].forEach(el => {
        if (el && el.textContent) {
          el.textContent = isUppercase ? el.textContent.toUpperCase() : el.textContent.toLowerCase();
        }
      });
    }

    // --- HMAC Checkbox Toggle ---
    enableHmacCheckbox?.addEventListener('change', () => {
      const active = enableHmacCheckbox.checked;
      if (active) {
        hmacKeyContainer?.classList.remove('hidden');
        hmacActiveBadge?.classList.remove('hidden');
      } else {
        hmacKeyContainer?.classList.add('hidden');
        hmacActiveBadge?.classList.add('hidden');
      }
      computeHashes();
    });

    hmacSecretInput?.addEventListener('input', computeHashes);

    // --- Text Input Calculations ---
    function updateTextStats(str) {
      if (statCharCount) statCharCount.textContent = str.length.toLocaleString();
      const encoder = new TextEncoder();
      const bytes = encoder.encode(str);
      if (statByteCount) statByteCount.textContent = bytes.length.toLocaleString();
      return bytes;
    }

    async function computeHashes() {
      let dataBytes;

      if (isFileMode) {
        if (!currentFileBytes) return;
        dataBytes = currentFileBytes;
      } else {
        const text = textInput ? textInput.value : '';
        dataBytes = updateTextStats(text);
      }

      const isHmac = enableHmacCheckbox ? enableHmacCheckbox.checked : false;
      const secretKeyStr = hmacSecretInput ? hmacSecretInput.value : '';
      
      if (isHmac && secretKeyStr.length === 0) {
        if (window.showToast) window.showToast('Please enter an HMAC Secret Key', 'error');
        if (outMd5) outMd5.textContent = '--';
        if (outSha1) outSha1.textContent = '--';
        if (outSha256) outSha256.textContent = '--';
        if (outSha512) outSha512.textContent = '--';
        return;
      }
      
      const keyBytes = new TextEncoder().encode(secretKeyStr);

      try {
        let md5Hex, sha1Hex, sha256Hex, sha512Hex;

        if (isHmac) {
          md5Hex = hmacMd5(keyBytes, dataBytes);
          sha1Hex = await hmacSubtle('SHA-1', keyBytes, dataBytes);
          sha256Hex = await hmacSubtle('SHA-256', keyBytes, dataBytes);
          sha512Hex = await hmacSubtle('SHA-512', keyBytes, dataBytes);
        } else {
          md5Hex = md5Uint8Array(dataBytes);
          sha1Hex = await hashSubtle('SHA-1', dataBytes);
          sha256Hex = await hashSubtle('SHA-256', dataBytes);
          sha512Hex = await hashSubtle('SHA-512', dataBytes);
        }

        if (outMd5) outMd5.textContent = isUppercase ? md5Hex.toUpperCase() : md5Hex.toLowerCase();
        if (outSha1) outSha1.textContent = isUppercase ? sha1Hex.toUpperCase() : sha1Hex.toLowerCase();
        if (outSha256) outSha256.textContent = isUppercase ? sha256Hex.toUpperCase() : sha256Hex.toLowerCase();
        if (outSha512) outSha512.textContent = isUppercase ? sha512Hex.toUpperCase() : sha512Hex.toLowerCase();

      } catch (err) {
        console.error('Hash calculation error:', err);
      }
    }

    textInput?.addEventListener('input', () => {
      if (!isFileMode) computeHashes();
    });

    clearTextBtn?.addEventListener('click', () => {
      if (textInput) textInput.value = '';
      computeHashes();
      textInput?.focus();
    });

    // --- File Handling & Drag Drop ---
    function formatFileSize(bytes) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function processFile(file) {
      if (!file) return;

      const maxBytes = 100 * 1024 * 1024; // 100MB
      if (file.size > maxBytes) {
        if (window.showToast) window.showToast('File size exceeds 100MB limit', 'error');
        return;
      }

      if (fileNameEl) fileNameEl.textContent = file.name;
      if (fileSizeEl) fileSizeEl.textContent = formatFileSize(file.size);
      if (fileTypeEl) fileTypeEl.textContent = file.type || 'binary/unknown';
      if (fileCalcStatus) {
        fileCalcStatus.textContent = 'Reading & hashing file...';
        fileCalcStatus.className = 'text-xs font-semibold text-accent animate-pulse';
      }

      fileInfoBanner?.classList.remove('hidden');

      const reader = new FileReader();
      const startTime = performance.now();

      reader.onload = function(e) {
        const arrayBuffer = e.target.result;
        currentFileBytes = new Uint8Array(arrayBuffer);

        computeHashes().then(() => {
          const duration = Math.round(performance.now() - startTime);
          if (fileCalcStatus) {
            fileCalcStatus.textContent = `Completed in ${duration} ms`;
            fileCalcStatus.className = 'text-xs font-semibold text-success';
          }
        });
      };

      reader.onerror = function() {
        if (fileCalcStatus) {
          fileCalcStatus.textContent = 'Error reading file';
          fileCalcStatus.className = 'text-xs font-semibold text-error';
        }
      };

      reader.readAsArrayBuffer(file);
    }

    dropzone?.addEventListener('click', () => fileInput?.click());

    fileInput?.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        processFile(e.target.files[0]);
      }
    });

    dropzone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.classList.add('border-accent', 'bg-accent/10');
    });

    dropzone?.addEventListener('dragleave', () => {
      dropzone.classList.remove('border-accent', 'bg-accent/10');
    });

    dropzone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.classList.remove('border-accent', 'bg-accent/10');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        processFile(e.dataTransfer.files[0]);
      }
    });

    removeFileBtn?.addEventListener('click', () => {
      currentFileBytes = null;
      if (fileInput) fileInput.value = '';
      fileInfoBanner?.classList.add('hidden');
      if (isFileMode) {
        [outMd5, outSha1, outSha256, outSha512].forEach(el => {
          if (el) el.textContent = '--';
        });
      }
    });

    // --- Copy Single Hash Buttons ---
    document.querySelectorAll('.copy-hash-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const targetEl = document.getElementById(targetId);
        if (targetEl && targetEl.textContent && targetEl.textContent !== '--') {
          if (window.copyToClipboard) {
            window.copyToClipboard(targetEl.textContent, 'Hash copied!');
          }
        }
      });
    });

    // --- Copy All Hashes Button ---
    document.getElementById('copy-all-hashes-btn')?.addEventListener('click', () => {
      const md5 = outMd5?.textContent || '--';
      const sha1 = outSha1?.textContent || '--';
      const sha256 = outSha256?.textContent || '--';
      const sha512 = outSha512?.textContent || '--';

      const isHmac = enableHmacCheckbox?.checked;
      const title = isHmac ? '### HMAC Cryptographic Hashes\n' : '### Cryptographic Hashes\n';
      const formatted = `${title}` +
        `MD5: ${md5}\n` +
        `SHA-1: ${sha1}\n` +
        `SHA-256: ${sha256}\n` +
        `SHA-512: ${sha512}`;

      if (window.copyToClipboard) {
        window.copyToClipboard(formatted, 'All hashes copied to clipboard!');
      }
    });

    // Initial calculation for empty string text input
    computeHashes();
  });
</script>
