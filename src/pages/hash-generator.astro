          <span id="case-status-label">Lowercase</span>
        </button>

        <!-- Copy All Button -->
        <button
          id="copy-all-hashes-btn"
          class="px-3.5 py-1.5 rounded-lg bg-accent/10 border border-accent/30 hover:bg-accent/20 text-accent text-xs font-semibold transition-colors cursor-pointer flex items-center gap-1.5"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          Copy All Hashes
        </button>
      </div>
    </div>

    <!-- MAIN INPUT AREA -->
    <!-- Section A: Text Input Mode -->
    <div id="panel-text-mode" class="space-y-6">
      <div class="p-6 rounded-2xl bg-bg-secondary border border-border-primary shadow-md">
        <div class="flex items-center justify-between mb-2">
          <label for="text-input" class="text-xs font-semibold text-text-secondary uppercase tracking-wider">
            Input Text to Hash
          </label>
          <div class="flex items-center gap-4 text-xs font-mono text-text-tertiary">
            <span>Chars: <strong id="stat-char-count" class="text-text-primary">0</strong></span>
            <span>Bytes: <strong id="stat-byte-count" class="text-text-primary">0</strong></span>
            <button id="clear-text-btn" class="text-text-tertiary hover:text-red-400 font-sans cursor-pointer underline">Clear</button>
          </div>
        </div>
        <textarea
          id="text-input"
          rows="4"
          placeholder="Type or paste text here to generate hashes in real time..."
          class="w-full px-4 py-3 rounded-xl bg-bg-tertiary border border-border-secondary focus:border-accent text-text-primary font-mono text-sm outline-none transition-all resize-y placeholder:text-text-tertiary"
        ></textarea>

        <!-- HMAC Secret Key Controls -->
        <div class="mt-4 pt-4 border-t border-border-primary flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-semibold text-text-primary">
            <input type="checkbox" id="enable-hmac-checkbox" class="accent-accent w-4 h-4 rounded cursor-pointer" />
            <span>Enable HMAC Mode (Secret Key)</span>
          </label>
          <div id="hmac-key-container" class="flex-1 max-w-md hidden">
            <input
              type="text"
              id="hmac-secret-input"
              placeholder="Enter HMAC Secret Key..."
              class="w-full px-3 py-1.5 rounded-lg bg-bg-tertiary border border-border-secondary focus:border-accent text-text-primary font-mono text-xs outline-none"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Section B: File Input Mode (Hidden by default) -->
    <div id="panel-file-mode" class="space-y-6 hidden">
      <div class="p-6 rounded-2xl bg-bg-secondary border border-border-primary shadow-md">
        <label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-3">
          Upload File to Calculate Checksum (Max 100MB)
