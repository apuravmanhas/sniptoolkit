      <div class="p-4 rounded-xl bg-bg-secondary border border-border-primary shadow-sm hover:border-border-secondary transition-colors">
        <div class="flex items-center justify-between mb-1.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold font-mono uppercase px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20">SHA-512</span>
            <span class="text-[11px] text-text-tertiary">512-bit high-security digest</span>
          </div>
          <button class="copy-hash-btn px-2.5 py-1 rounded bg-bg-tertiary hover:bg-border-primary text-text-secondary hover:text-text-primary text-xs font-medium transition-colors cursor-pointer flex items-center gap-1" data-target="hash-sha512">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
