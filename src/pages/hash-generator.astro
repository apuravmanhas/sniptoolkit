      </div>

      <!-- SHA-256 Card (Primary) -->
      <div class="p-4.5 rounded-xl bg-bg-secondary border-2 border-accent/40 shadow-md relative overflow-hidden">
        <div class="flex items-center justify-between mb-1.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold font-mono uppercase px-2 py-0.5 rounded bg-accent/20 text-accent border border-accent/40">SHA-256</span>
            <span class="text-[11px] font-semibold text-accent">Recommended Standard</span>
          </div>
          <button class="copy-hash-btn px-3 py-1 rounded bg-accent/20 hover:bg-accent/30 text-accent text-xs font-semibold transition-colors cursor-pointer flex items-center gap-1" data-target="hash-sha256">
