---
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Online JSON Formatter & Validator",
      "operatingSystem": "Any",
      "applicationCategory": "DeveloperApplication",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Free client-side JSON formatter, beautifier, and validator with line-by-line syntax error highlighting."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does the online JSON formatter work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paste your raw JSON string into the input area and select your formatting preference (2 spaces, 4 spaces, or tab). Our tool validates the syntax using native browser parsing and formats the output instantly."
          }
        },
        {
          "@type": "Question",
          "name": "Is my JSON data secure when using this tool?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, 100% safe! All parsing and formatting occur locally inside your web browser. Your JSON data is never uploaded to any server."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if my JSON has syntax errors?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The validator highlights the exact line number and character offset of the error, showing a clear error message to help you fix missing quotes, commas, or brackets."
          }
        }
      ]
    }
  ]
};

const relatedTools = [
  { name: 'Base64 Encode/Decode', slug: '/base64', icon: '⟨⟩' },
  { name: 'UUID Generator', slug: '/uuid-generator', icon: '#' },
  { name: 'URL Encode/Decode', slug: '/url-encode-decode', icon: '%' }
];
---

<BaseLayout
  title="JSON Formatter & Validator Online — Free & Private | SnipTools"
  description="Format, validate, beautify, and minify JSON online. Features line error highlighting, file upload, 100% client-side privacy, and zero server logging."
  canonicalUrl="https://sniptoolkit.com/json-formatter/"
  structuredData={structuredData}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Tool Header -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-border-secondary bg-bg-tertiary px-3.5 py-1 text-xs font-semibold text-accent mb-3">
        <span>{ } JSON Utility</span>
        <span class="text-text-tertiary">•</span>
        <span class="text-text-secondary">100% Client-Side</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight mb-2">
        JSON Formatter & Validator
      </h1>
      <p class="text-sm text-text-secondary max-w-xl mx-auto">
        Beautify, validate, and minify raw JSON payloads instantly with line error highlighting.
      </p>
    </div>

    <!-- Main Workspace Card -->
    <div class="rounded-2xl border border-border-primary bg-bg-secondary p-4 sm:p-6 mb-12 shadow-xl">
      <!-- Action Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-border-primary">
        <div class="flex flex-wrap items-center gap-2">
          <button id="btn-format" class="btn-click-effect px-4 py-2 rounded-xl bg-accent hover:bg-accent-hover text-white text-xs font-bold shadow-md shadow-accent/20 cursor-pointer">
            ✨ Beautify JSON
          </button>
          <button id="btn-minify" class="btn-click-effect px-3.5 py-2 rounded-xl bg-bg-tertiary hover:bg-bg-hover border border-border-primary text-text-primary text-xs font-semibold cursor-pointer">
            ⚡ Minify
          </button>
          <button id="btn-sample" class="btn-click-effect px-3.5 py-2 rounded-xl bg-bg-tertiary hover:bg-bg-hover border border-border-primary text-text-secondary hover:text-text-primary text-xs font-medium cursor-pointer">
            Sample Data
          </button>
          <button id="btn-clear" class="btn-click-effect px-3 py-2 rounded-xl text-text-tertiary hover:text-error hover:bg-error/10 text-xs font-medium cursor-pointer">
            Clear
          </button>
        </div>

        <div class="flex items-center gap-3">
          <label class="text-xs text-text-tertiary flex items-center gap-1.5">
            Indent:
            <select id="indent-select" class="bg-bg-tertiary border border-border-primary rounded-lg px-2 py-1 text-xs text-text-primary outline-none focus:border-accent">
              <option value="2">2 Spaces</option>
              <option value="4">4 Spaces</option>
              <option value="tab">Tab</option>
            </select>
          </label>

          <button id="btn-copy" class="btn-click-effect px-3.5 py-2 rounded-xl bg-bg-tertiary hover:bg-bg-hover border border-border-primary text-text-primary text-xs font-semibold flex items-center gap-1.5 cursor-pointer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy</span>
          </button>

          <button id="btn-download" class="btn-click-effect px-3.5 py-2 rounded-xl bg-bg-tertiary hover:bg-bg-hover border border-border-primary text-text-primary text-xs font-semibold flex items-center gap-1.5 cursor-pointer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Download</span>
          </button>
        </div>
      </div>

      <!-- Status Banner -->
      <div id="status-bar" class="my-3 p-3 rounded-xl border text-xs font-medium flex items-center justify-between hidden">
        <div id="status-message" class="flex items-center gap-2"></div>
        <div id="status-stats" class="font-mono text-text-tertiary"></div>
      </div>

      <!-- Split Textarea Workspace -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-3">
        <!-- Input Panel -->
        <div class="flex flex-col">
          <div class="flex items-center justify-between text-xs text-text-tertiary mb-1.5">
            <span class="font-semibold uppercase tracking-wider">Input Raw JSON</span>
            <span id="input-stats" class="font-mono">0 chars</span>
          </div>
          <textarea
            id="json-input"
            aria-label="JSON Input"
            class="code-textarea w-full h-[420px] p-3.5 rounded-xl bg-bg-primary border border-border-primary text-text-primary outline-none focus:border-accent transition-colors"
            placeholder="Paste your raw JSON string here..."
            spellcheck="false"
          ></textarea>
        </div>

        <!-- Output Panel -->
        <div class="flex flex-col">
          <div class="flex items-center justify-between text-xs text-text-tertiary mb-1.5">
            <span class="font-semibold uppercase tracking-wider">Formatted / Minified Output</span>
            <span id="output-stats" class="font-mono">0 chars</span>
          </div>
          <textarea
            id="json-output"
            aria-label="JSON Output"
            readonly
            class="code-textarea w-full h-[420px] p-3.5 rounded-xl bg-bg-primary border border-border-primary text-text-primary outline-none focus:border-border-secondary transition-colors"
            placeholder="Formatted JSON will appear here..."
            spellcheck="false"
          ></textarea>
        </div>
      </div>
    </div>

    <!-- What is JSON Formatting Section -->
    <div class="rounded-2xl border border-border-primary bg-bg-secondary p-6 sm:p-10 mb-12 space-y-6 text-sm text-text-secondary leading-relaxed">
      <h2 class="text-2xl font-bold text-text-primary tracking-tight">What is JSON Formatting?</h2>
      <p>
        JSON (JavaScript Object Notation) is a lightweight data-interchange format that is easy for humans to read and write, and easy for machines to parse and generate. JSON formatting, often referred to as beautifying or pretty-printing, is the process of organizing raw JSON strings by adding proper indentation, line breaks, and spacing. 
      </p>
      <p>
        Proper formatting and validation are crucial for developers debugging API responses, managing configuration files, or inspecting complex data structures. Minified JSON is great for saving bandwidth during network transfers, but it is nearly impossible to read manually. By formatting JSON, you can quickly spot syntax errors, nested object structures, and missing keys. 
      </p>
      <p>
        SnipTools provides a secure environment for this process. Everything happens 100% client-side in your browser, ensuring your sensitive API payloads, configuration files, and personal data never leave your device.
      </p>
    </div>

    <!-- SEO Content Section -->
    <div class="rounded-2xl border border-border-primary bg-bg-secondary p-6 sm:p-10 mb-12 space-y-6 text-sm text-text-secondary leading-relaxed">
      <h2 class="text-2xl font-bold text-text-primary tracking-tight">How to Format & Validate JSON Online</h2>
      <p>
        JSON (JavaScript Object Notation) is the standard data-interchange format for modern APIs, web applications, and configuration files. Raw JSON responses from servers are often minified into a single line to save bandwidth, making them difficult for developers to read or debug.
      </p>

      <h3 class="text-base font-bold text-text-primary pt-2">How to Use</h3>
      <ol class="list-decimal pl-5 space-y-1.5 text-xs text-text-secondary">
        <li>Paste your JSON into the input editor</li>
        <li>Click 'Format' to pretty-print with proper indentation</li>
        <li>Click 'Validate' to check for syntax errors</li>
        <li>Use 'Minify' to compress JSON by removing whitespace</li>
        <li>Click 'Copy' to copy the result to your clipboard</li>
      </ol>
      
      <h3 class="text-base font-bold text-text-primary pt-2">Key Features of SnipTools JSON Formatter</h3>
      <ul class="list-disc pl-5 space-y-1.5 text-xs text-text-secondary">
        <li><strong>Line-by-Line Error Detection:</strong> Instantly catches syntax errors such as trailing commas, unquoted keys, or mismatched brackets.</li>
        <li><strong>Custom Indentation:</strong> Format with 2 spaces, 4 spaces, or tab indents for your preferred coding style.</li>
        <li><strong>Minifier Mode:</strong> Compress formatted JSON down to a single line for production payload optimization.</li>
        <li><strong>100% Client-Side Privacy:</strong> All formatting runs inside your browser. No data is sent over the network.</li>
      </ul>

      <h3 class="text-base font-bold text-text-primary pt-2">Frequently Asked Questions</h3>
      <div class="space-y-3">
        {structuredData['@graph'][1].mainEntity.map(faq => (
          <div class="p-4 rounded-xl border border-border-primary bg-bg-tertiary/50">
            <h4 class="font-semibold text-text-primary text-xs mb-1">Q: {faq.name}</h4>
            <p class="text-xs text-text-tertiary">{faq.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Related Tools -->
    <div>
      <h3 class="text-sm font-bold text-text-primary uppercase tracking-wider mb-4">Related Developer Tools</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {relatedTools.map(tool => (
          <a href={tool.slug} class="p-4 rounded-xl bg-bg-secondary border border-border-primary hover:border-accent transition-all flex items-center gap-3 no-underline">
            <span class="text-xl">{tool.icon}</span>
            <span class="text-sm font-semibold text-text-primary">{tool.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const jsonInput = document.getElementById('json-input');
  const jsonOutput = document.getElementById('json-output');
  const statusBar = document.getElementById('status-bar');
  const statusMsg = document.getElementById('status-message');
  const statusStats = document.getElementById('status-stats');
  const inputStats = document.getElementById('input-stats');
  const outputStats = document.getElementById('output-stats');
  const indentSelect = document.getElementById('indent-select');

  const sampleJSON = {
    "site": "SnipTools",
    "url": "https://sniptoolkit.com",
    "features": ["JSON Formatter", "Base64 Converter", "UUID Generator"],
    "privacy": {
      "clientSideOnly": true,
      "serverUploads": false
    },
    "metrics": {
      "latency": "0ms",
      "rating": 5.0
    }
  };

  function getIndent() {
    const val = indentSelect.value;
    if (val === 'tab') return '\t';
    return parseInt(val, 10);
  }

  function processJSON(isMinify = false) {
    const val = jsonInput.value.trim();
    if (!val) {
      jsonOutput.value = '';
      statusBar.classList.add('hidden');
      inputStats.textContent = '0 chars';
      outputStats.textContent = '0 chars';
      return;
    }

    inputStats.textContent = `${val.length.toLocaleString()} chars`;

    try {
      const parsed = JSON.parse(val);
      const formatted = isMinify ? JSON.stringify(parsed) : JSON.stringify(parsed, null, getIndent());
      
      jsonOutput.value = formatted;
      outputStats.textContent = `${formatted.length.toLocaleString()} chars`;

      statusBar.className = 'my-3 p-3 rounded-xl border text-xs font-medium flex items-center justify-between border-success/30 bg-success/10 text-success';
      statusMsg.textContent = '✓ Valid JSON';
      const diffPercent = Math.round(((val.length - formatted.length) / val.length) * 100);
      statusStats.textContent = diffPercent < 0 ? `Size: +${Math.abs(diffPercent)}%` : `Reduction: ${diffPercent}%`;
      statusBar.classList.remove('hidden');
    } catch (err) {
      jsonOutput.value = '';
      outputStats.textContent = '0 chars';

      statusBar.className = 'my-3 p-3 rounded-xl border text-xs font-medium flex items-center justify-between border-error/30 bg-error/10 text-error';
      statusMsg.textContent = `✕ Invalid JSON: ${err.message}`;
      statusStats.textContent = 'Syntax Error';
      statusBar.classList.remove('hidden');
    }
  }

  // Event Listeners
  document.getElementById('btn-format')?.addEventListener('click', () => processJSON(false));
  document.getElementById('btn-minify')?.addEventListener('click', () => processJSON(true));
  document.getElementById('btn-sample')?.addEventListener('click', () => {
    jsonInput.value = JSON.stringify(sampleJSON);
    processJSON(false);
  });
  document.getElementById('btn-clear')?.addEventListener('click', () => {
    jsonInput.value = '';
    jsonOutput.value = '';
    statusBar.classList.add('hidden');
    inputStats.textContent = '0 chars';
    outputStats.textContent = '0 chars';
  });

  document.getElementById('btn-copy')?.addEventListener('click', () => {
    if (window.copyToClipboard) window.copyToClipboard(jsonOutput.value, 'Formatted JSON copied!');
  });

  document.getElementById('btn-download')?.addEventListener('click', () => {
    const val = jsonOutput.value;
    if (!val) return;
    const blob = new Blob([val], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'formatted.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  jsonInput?.addEventListener('input', () => processJSON(false));
  indentSelect?.addEventListener('change', () => processJSON(false));
</script>
