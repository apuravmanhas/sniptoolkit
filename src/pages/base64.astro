        </div>

        <!-- Output Textarea -->
        <div class="p-4 bg-bg-primary min-h-[360px] flex flex-col">
          <textarea
            id="text-output"
            readonly
            spellcheck="false"
            placeholder="Converted Base64 or decoded text will appear here..."
            class="w-full flex-1 bg-transparent text-sm font-mono text-text-primary placeholder:text-text-tertiary focus:outline-none resize-none min-h-[300px] select-all"
