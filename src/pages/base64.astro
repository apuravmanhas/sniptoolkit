        </div>

        <!-- Panel Footer -->
        <div class="px-4 py-2 border-t border-border-primary bg-bg-tertiary/30 flex items-center justify-between text-[11px] text-text-tertiary font-mono">
          <span id="b64-ratio-stat">Size change: 0%</span>
          <span>Shortcut: <kbd class="px-1.5 py-0.5 rounded bg-bg-tertiary border border-border-primary text-[10px]">Ctrl+Alt+C</kbd> Copy</span>
