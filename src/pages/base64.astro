          <span>UTF-8 Encoding Supported</span>
        </div>
      </div>

      <!-- Right Output Panel -->
      <div class="flex flex-col rounded-2xl border border-border-primary bg-bg-secondary overflow-hidden shadow-lg shadow-black/20">
        <!-- Panel Header -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-border-primary bg-bg-tertiary/60">
          <div class="flex items-center gap-2">
            <span id="output-label" class="text-xs font-bold uppercase tracking-wider text-text-primary">Output Result</span>
            <span id="output-b64-stats" class="text-[11px] font-mono text-text-tertiary">0 chars • 0 B</span>
          </div>
          <div class="flex items-center gap-2">
            <button id="btn-copy-result" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-accent hover:bg-accent-hover text-white shadow-sm transition-all cursor-pointer flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy
