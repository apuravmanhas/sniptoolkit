---
import BaseLayout from '../layouts/BaseLayout.astro';

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Base64 Encode & Decode",
  "operatingSystem": "All",
  "applicationCategory": "DeveloperApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free online Base64 encoder and decoder. Convert text to Base64, decode Base64 strings, convert files and images to Base64 data URIs with instant preview."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "QAPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Base64 encoding?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Base64 is a binary-to-text encoding scheme that represents binary data in an ASCII string format using 64 characters (A-Z, a-z, 0-9, +, and /). It is commonly used to transfer data over media designed for text."
      }
    },
    {
      "@type": "Question",
      "name": "Is my data secure when converting text or files to Base64 on SnipTools?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, 100%. All Base64 encoding and decoding operations happen locally within your browser using native Web APIs (TextEncoder, TextDecoder, FileReader). No text or uploaded file is transmitted over the internet."
      }
    },
    {
      "@type": "Question",
      "name": "How do I convert an image or file to Base64?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Switch to the 'File to Base64' tab, upload or drag & drop your image or document, and SnipTools will generate both raw Base64 code and HTML/CSS Data URIs (`data:image/png;base64,...`) ready to use in your code."
      }
    },
    {
      "@type": "Question",
      "name": "Does this Base64 tool support UTF-8 special characters and emojis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Unlike basic JavaScript atob/btoa functions which fail on multi-byte characters, SnipTools uses UTF-8 TextEncoder and TextDecoder to ensure emojis, non-Latin scripts, and special characters encode and decode perfectly."
      }
    }
  ]
};

const structuredData = [softwareSchema, faqSchema];

const relatedTools = [
  {
    name: 'JSON Formatter & Validator',
    slug: '/json-formatter',
    icon: '{ }',
    category: 'Data',
    description: 'Format, validate, beautify, and minify JSON data instantly with line error highlighting.'
  },
  {
    name: 'URL Encode & Decode',
    slug: '/url-encode-decode',
    icon: '%',
    category: 'Encoding',
    description: 'Safely encode special characters for URLs or decode percent-encoded query strings.'
  },
  {
    name: 'Hash Generator (MD5 / SHA)',
    slug: '/hash-generator',
    icon: '🔒',
    category: 'Security',
    description: 'Generate secure cryptographic hashes including MD5, SHA-1, SHA-256, and SHA-512.'
  },
  {
    name: 'Word & Character Counter',
    slug: '/word-counter',
    icon: 'Aa',
    category: 'Text',
    description: 'Count words, characters, sentences, paragraphs, and estimate reading time in real time.'
  }
];
---

<BaseLayout
  title="Base64 Encode & Decode Online — Free Converter | SnipTools"
  description="Free online Base64 Encoder & Decoder. Convert text to Base64, decode Base64 to text, convert images & files to Base64 data URIs. 100% private, client-side."
  structuredData={structuredData}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-medium text-text-tertiary mb-4">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-text-secondary">Encoding</span>
      <span>/</span>
      <span class="text-accent font-semibold">Base64 Encode & Decode</span>
    </nav>

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight">
          Base64 Encode & Decode
        </h1>
        <p class="text-sm sm:text-base text-text-secondary mt-1 max-w-2xl">
          Convert plain text or binary files into Base64 strings, or decode Base64 back to original readable text. Full UTF-8 & image preview support.
        </p>
      </div>

      <!-- Quick Options -->
      <div class="flex flex-wrap items-center gap-2">
        <button id="btn-sample-text" class="px-3.5 py-2 text-xs font-medium rounded-xl bg-bg-secondary border border-border-primary hover:border-border-hover text-text-primary transition-all cursor-pointer flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          Sample Text
        </button>
        <button id="btn-clear-all" class="px-3.5 py-2 text-xs font-medium rounded-xl bg-bg-secondary border border-border-primary hover:border-error/40 hover:text-error text-text-tertiary transition-all cursor-pointer flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          Clear
        </button>
      </div>
    </div>

    <!-- Main Navigation Tabs -->
    <div class="flex flex-wrap items-center gap-2 p-1.5 rounded-2xl bg-bg-secondary border border-border-primary mb-6">
      <button class="mode-tab active flex-1 sm:flex-none px-4 py-2 text-xs font-bold rounded-xl bg-accent text-white transition-all cursor-pointer shadow-sm text-center" data-mode="auto">
        Auto Detect
      </button>
      <button class="mode-tab flex-1 sm:flex-none px-4 py-2 text-xs font-semibold rounded-xl text-text-secondary hover:text-text-primary transition-all cursor-pointer text-center" data-mode="encode">
        Encode Text
      </button>
      <button class="mode-tab flex-1 sm:flex-none px-4 py-2 text-xs font-semibold rounded-xl text-text-secondary hover:text-text-primary transition-all cursor-pointer text-center" data-mode="decode">
        Decode Base64
      </button>
      <button class="mode-tab flex-1 sm:flex-none px-4 py-2 text-xs font-semibold rounded-xl text-text-secondary hover:text-text-primary transition-all cursor-pointer text-center" data-mode="file">
        File to Base64
      </button>

      <!-- Advanced Options Toggles -->
      <div class="ml-auto hidden sm:flex items-center gap-4 px-2">
        <label class="flex items-center gap-2 text-xs text-text-secondary cursor-pointer select-none">
          <input type="checkbox" id="chk-url-safe" class="w-3.5 h-3.5 rounded border-border-secondary text-accent focus:ring-accent accent-accent" />
          <span>URL-Safe Base64</span>
        </label>
      </div>
    </div>

    <!-- Error Alert Container -->
    <div id="b64-error-container" class="hidden mb-6 rounded-xl border border-error/40 bg-error/10 p-4 animate-slide-down">
      <div class="flex items-start gap-3">
        <div class="p-1.5 rounded-lg bg-error/20 text-error flex-shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="flex-1">
          <h3 class="text-sm font-bold text-error">Invalid Base64 Input</h3>
