          <div class="flex items-center justify-between px-4 py-3 border-b border-border-primary bg-bg-tertiary/60">
            <div class="flex items-center gap-2">
              <button id="btn-file-dataurl" class="px-3 py-1 text-xs font-bold rounded-lg bg-bg-primary border border-border-secondary text-text-primary">Data URI</button>
              <button id="btn-file-rawb64" class="px-3 py-1 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary">Raw Base64</button>
            </div>
            <button id="btn-copy-file-b64" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-accent hover:bg-accent-hover text-white transition-all cursor-pointer">
              Copy Base64
            </button>
          </div>

          <div class="p-4 bg-bg-primary flex-1 min-h-[220px]">
            <textarea
              id="file-b64-output"
              readonly
              spellcheck="false"
              class="w-full h-full bg-transparent text-xs font-mono text-text-primary placeholder:text-text-tertiary focus:outline-none resize-none select-all leading-relaxed"
            ></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- How to Use Section -->
    <section class="mt-16 pt-12 border-t border-border-primary">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-text-primary tracking-tight mb-2">How to Use the Online Base64 Converter</h2>
        <p class="text-sm text-text-secondary mb-8">Follow these simple steps to encode or decode text and binary media.</p>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="p-5 rounded-2xl bg-bg-secondary border border-border-primary">
            <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent font-bold flex items-center justify-center text-sm mb-3">1</div>
            <h3 class="text-sm font-semibold text-text-primary mb-1">Choose Mode</h3>
            <p class="text-xs text-text-secondary leading-relaxed">Select Auto Detect, Encode Text, Decode Base64, or File to Base64 from the top tabs.</p>
          </div>

          <div class="p-5 rounded-2xl bg-bg-secondary border border-border-primary">
            <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent font-bold flex items-center justify-center text-sm mb-3">2</div>
            <h3 class="text-sm font-semibold text-text-primary mb-1">Input Text or File</h3>
            <p class="text-xs text-text-secondary leading-relaxed">Type your raw text, paste a Base64 string, or drop an image file into the converter box.</p>
          </div>

          <div class="p-5 rounded-2xl bg-bg-secondary border border-border-primary">
            <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent font-bold flex items-center justify-center text-sm mb-3">3</div>
            <h3 class="text-sm font-semibold text-text-primary mb-1">Configure Options</h3>
            <p class="text-xs text-text-secondary leading-relaxed">Toggle URL-Safe Base64 mode if needed for web parameters and query strings.</p>
          </div>

          <div class="p-5 rounded-2xl bg-bg-secondary border border-border-primary">
            <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent font-bold flex items-center justify-center text-sm mb-3">4</div>
            <h3 class="text-sm font-semibold text-text-primary mb-1">Copy Result</h3>
            <p class="text-xs text-text-secondary leading-relaxed">Click Copy Result to instantly copy your encoded or decoded output with toast feedback.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mt-16 pt-12 border-t border-border-primary">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-text-primary tracking-tight mb-2">Frequently Asked Questions</h2>
        <p class="text-sm text-text-secondary mb-8">Common questions regarding Base64 encoding and security.</p>

        <div class="space-y-4">
          {faqSchema.mainEntity.map((faq) => (
            <div class="rounded-xl border border-border-primary bg-bg-secondary p-5">
              <h3 class="text-base font-semibold text-text-primary mb-2 flex items-center gap-2">
                <span class="text-accent font-bold">Q:</span> {faq.name}
              </h3>
              <p class="text-xs text-text-secondary leading-relaxed pl-6">
                {faq.acceptedAnswer.text}
