    </div>

    <!-- File to Base64 Workspace Pane (Hidden by default) -->
    <div id="pane-file-workspace" class="hidden flex-col gap-6">
      <div class="rounded-2xl border border-border-primary bg-bg-secondary p-8 text-center relative overflow-hidden" id="file-drop-zone">
        <input type="file" id="b64-file-input" class="hidden" />

        <div class="flex flex-col items-center justify-center max-w-md mx-auto">
