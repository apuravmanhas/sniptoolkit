            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Tools Grid -->
    <section class="mt-16 pt-12 border-t border-border-primary">
      <h2 class="text-xl font-bold text-text-primary mb-6">Related Encoding & Developer Tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {relatedTools.map((tool) => (
          <a href={tool.slug} class="group p-5 rounded-xl bg-bg-secondary border border-border-primary hover:border-border-hover transition-all no-underline flex flex-col justify-between">
            <div>
              <div class="text-lg font-bold text-text-primary group-hover:text-accent transition-colors mb-1">{tool.name}</div>
              <p class="text-xs text-text-secondary leading-relaxed line-clamp-2">{tool.description}</p>
            </div>
            <div class="mt-4 flex items-center gap-1 text-xs font-semibold text-accent">
              <span>Try Tool</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const textInput = document.getElementById('text-input');
    const textOutput = document.getElementById('text-output');
    const inputStats = document.getElementById('input-b64-stats');
    const outputStats = document.getElementById('output-b64-stats');
    const b64RatioStat = document.getElementById('b64-ratio-stat');
    const chkUrlSafe = document.getElementById('chk-url-safe');
    const b64ErrorContainer = document.getElementById('b64-error-container');
    const b64ErrorText = document.getElementById('b64-error-text');
    const currentActionBadge = document.getElementById('current-action-badge');

    const paneText = document.getElementById('pane-text-workspace');
    const paneFile = document.getElementById('pane-file-workspace');
    const modeTabs = document.querySelectorAll('.mode-tab');

    const btnSampleText = document.getElementById('btn-sample-text');
    const btnClearAll = document.getElementById('btn-clear-all');
    const btnCopyResult = document.getElementById('btn-copy-result');

    // File mode elements
    const fileDropZone = document.getElementById('file-drop-zone');
    const b64FileInput = document.getElementById('b64-file-input');
    const btnBrowseFile = document.getElementById('btn-browse-file');
    const fileResultContainer = document.getElementById('file-result-container');
    const filePreviewBox = document.getElementById('file-preview-box');
    const fileNameStat = document.getElementById('file-name-stat');
    const fileTypeStat = document.getElementById('file-type-stat');
    const fileSizeStat = document.getElementById('file-size-stat');
    const fileB64SizeStat = document.getElementById('file-b64-size-stat');
    const fileB64Output = document.getElementById('file-b64-output');
    const btnFileDataUrl = document.getElementById('btn-file-dataurl');
    const btnFileRawB64 = document.getElementById('btn-file-rawb64');
    const btnCopyFileB64 = document.getElementById('btn-copy-file-b64');

    let currentMode = 'auto'; // 'auto', 'encode', 'decode', 'file'
    let currentFileDataUri = '';
    let currentFileRawB64 = '';
    let fileViewMode = 'dataurl'; // 'dataurl' or 'raw'

    const SAMPLE_TEXT = "SnipTools — Fast, Free Developer & Utility Tools! 🚀\n100% Client-Side & Private Base64 Conversion.";

    // Utility: Format bytes
    function formatBytes(bytes) {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    // UTF-8 Safe Text to Base64
    function encodeUTF8Base64(str, isUrlSafe = false) {
      const bytes = new TextEncoder().encode(str);
      let bin = '';
      for (let i = 0; i < bytes.length; i++) {
        bin += String.fromCharCode(bytes[i]);
      }
      let b64 = btoa(bin);
      if (isUrlSafe) {
        b64 = b64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      }
      return b64;
    }

    // UTF-8 Safe Base64 to Text
    function decodeUTF8Base64(b64, isUrlSafe = false) {
      let cleaned = b64.trim();
      if (isUrlSafe) {
        cleaned = cleaned.replace(/-/g, '+').replace(/_/g, '/');
        while (cleaned.length % 4 !== 0) cleaned += '=';
      }
      const bin = atob(cleaned);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) {
        bytes[i] = bin.charCodeAt(i);
      }
      return new TextDecoder().decode(bytes);
    }

    // Test if string looks like valid Base64
    function isBase64String(str) {
      if (!str || typeof str !== 'string') return false;
      const s = str.trim();
      if (s.length % 4 !== 0 && !s.includes('-') && !s.includes('_')) {
        // Might be unpadded urlsafe or invalid
        if (s.length < 4) return false;
      }
      // Regex check for standard base64 or URL safe base64
      const regex = /^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{2}==)?$/;
      const urlSafeRegex = /^[A-Za-z0-9_-]+$/;
      return regex.test(s) || urlSafeRegex.test(s);
    }

    // Convert function
    function convertText() {
      const val = textInput.value;
      b64ErrorContainer.classList.add('hidden');

      if (!val) {
        textOutput.value = '';
        inputStats.textContent = '0 chars • 0 B';
        outputStats.textContent = '0 chars • 0 B';
        b64RatioStat.textContent = 'Size change: 0%';
        return;
      }

      const isUrlSafe = chkUrlSafe.checked;
      const inputBytes = new Blob([val]).size;
      inputStats.textContent = `${val.length} chars • ${formatBytes(inputBytes)}`;

      let actionToTake = currentMode;
      if (currentMode === 'auto') {
        actionToTake = isBase64String(val) ? 'decode' : 'encode';
      }

      if (actionToTake === 'encode') {
        try {
          const res = encodeUTF8Base64(val, isUrlSafe);
          textOutput.value = res;
          currentActionBadge.textContent = 'Mode: Encoded';
          currentActionBadge.className = 'px-2 py-0.5 rounded text-[11px] font-mono bg-accent-subtle text-accent border border-accent/20';

          const outBytes = new Blob([res]).size;
          outputStats.textContent = `${res.length} chars • ${formatBytes(outBytes)}`;
          const pct = Math.round((outBytes / (inputBytes || 1)) * 100);
          b64RatioStat.textContent = `Size change: +${pct - 100}%`;
        } catch (err) {
          showError('Failed to encode string into Base64.');
        }
      } else if (actionToTake === 'decode') {
        try {
          const res = decodeUTF8Base64(val, isUrlSafe);
          textOutput.value = res;
          currentActionBadge.textContent = 'Mode: Decoded';
          currentActionBadge.className = 'px-2 py-0.5 rounded text-[11px] font-mono bg-success/15 text-success border border-success/30';

          const outBytes = new Blob([res]).size;
          outputStats.textContent = `${res.length} chars • ${formatBytes(outBytes)}`;
          const pct = Math.round((outBytes / (inputBytes || 1)) * 100);
          b64RatioStat.textContent = `Size change: ${pct - 100}%`;
        } catch (err) {
          // If auto mode failed decode, fallback to encoding
          if (currentMode === 'auto') {
            try {
              const res = encodeUTF8Base64(val, isUrlSafe);
              textOutput.value = res;
              currentActionBadge.textContent = 'Mode: Encoded';
              currentActionBadge.className = 'px-2 py-0.5 rounded text-[11px] font-mono bg-accent-subtle text-accent border border-accent/20';
              const outBytes = new Blob([res]).size;
              outputStats.textContent = `${res.length} chars • ${formatBytes(outBytes)}`;
            } catch {
              showError('Invalid Base64 string for decoding.');
            }
          } else {
            showError('Invalid Base64 string. Please check character formatting or padding.');
          }
        }
      }
    }

    function showError(msg) {
      b64ErrorText.textContent = msg;
      b64ErrorContainer.classList.remove('hidden');
      textOutput.value = '';
      outputStats.textContent = '0 chars • 0 B';
    }

    // Mode Tab Switcher
    modeTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        modeTabs.forEach(t => {
          t.classList.remove('active', 'bg-accent', 'text-white', 'font-bold');
          t.classList.add('text-text-secondary', 'font-semibold');
        });
        tab.classList.add('active', 'bg-accent', 'text-white', 'font-bold');
        tab.classList.remove('text-text-secondary');

        currentMode = tab.getAttribute('data-mode');

        if (currentMode === 'file') {
          paneText.classList.add('hidden');
          paneFile.classList.remove('hidden');
          paneFile.classList.add('flex');
        } else {
          paneFile.classList.add('hidden');
          paneFile.classList.remove('flex');
          paneText.classList.remove('hidden');
          convertText();
        }
      });
    });

    textInput.addEventListener('input', convertText);
    chkUrlSafe.addEventListener('change', convertText);

    btnSampleText.addEventListener('click', () => {
      textInput.value = SAMPLE_TEXT;
      convertText();
      window.showToast('Sample text loaded', 'info');
    });

    btnClearAll.addEventListener('click', () => {
      textInput.value = '';
      textOutput.value = '';
      b64ErrorContainer.classList.add('hidden');
      inputStats.textContent = '0 chars • 0 B';
      outputStats.textContent = '0 chars • 0 B';
      b64RatioStat.textContent = 'Size change: 0%';
      window.showToast('Cleared input', 'info');
    });

    btnCopyResult.addEventListener('click', () => {
      if (!textOutput.value) {
        window.showToast('Nothing to copy', 'error');
        return;
      }
      window.copyToClipboard(textOutput.value, 'Result copied to clipboard!');
    });

    // FILE TO BASE64 HANDLER
    btnBrowseFile.addEventListener('click', () => b64FileInput.click());

    function processUploadedFile(file) {
      if (!file) return;
      const reader = new FileReader();

      reader.onload = (e) => {
        currentFileDataUri = e.target.result;
        currentFileRawB64 = currentFileDataUri.split(',')[1] || '';

        // Fill Stats
        fileNameStat.textContent = file.name;
        fileTypeStat.textContent = file.type || 'Unknown';
        fileSizeStat.textContent = formatBytes(file.size);
        fileB64SizeStat.textContent = formatBytes(new Blob([currentFileDataUri]).size);

        // Preview rendering if image
        if (file.type.startsWith('image/')) {
          filePreviewBox.innerHTML = `<img src="${currentFileDataUri}" alt="File preview" class="max-h-full max-w-full object-contain rounded-lg shadow-sm" />`;
        } else {
          filePreviewBox.innerHTML = `<div class="text-center p-4"><span class="text-3xl block mb-1">📄</span><span class="text-xs text-text-tertiary">${file.name}</span></div>`;
        }

        // Show File Output Pane
        fileResultContainer.classList.remove('hidden');
        fileResultContainer.classList.add('grid');
        updateFileOutputDisplay();
        window.showToast(`Converted ${file.name} to Base64`, 'success');
      };

      reader.readAsDataURL(file);
    }

    function updateFileOutputDisplay() {
      if (fileViewMode === 'dataurl') {
        fileB64Output.value = currentFileDataUri;
        btnFileDataUrl.className = 'px-3 py-1 text-xs font-bold rounded-lg bg-accent text-white shadow-sm';
        btnFileRawB64.className = 'px-3 py-1 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary';
      } else {
        fileB64Output.value = currentFileRawB64;
        btnFileRawB64.className = 'px-3 py-1 text-xs font-bold rounded-lg bg-accent text-white shadow-sm';
        btnFileDataUrl.className = 'px-3 py-1 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary';
      }
    }

    btnFileDataUrl.addEventListener('click', () => {
      fileViewMode = 'dataurl';
      updateFileOutputDisplay();
    });

    btnFileRawB64.addEventListener('click', () => {
      fileViewMode = 'raw';
      updateFileOutputDisplay();
    });

    btnCopyFileB64.addEventListener('click', () => {
      if (!fileB64Output.value) return;
      window.copyToClipboard(fileB64Output.value, 'Base64 code copied!');
    });

    b64FileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        processUploadedFile(e.target.files[0]);
      }
    });

    // Drag & drop for file mode
    fileDropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      fileDropZone.classList.add('border-accent', 'bg-accent/5');
    });

    fileDropZone.addEventListener('dragleave', () => {
      fileDropZone.classList.remove('border-accent', 'bg-accent/5');
    });

    fileDropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      fileDropZone.classList.remove('border-accent', 'bg-accent/5');
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        processUploadedFile(e.dataTransfer.files[0]);
      }
    });

    // Keyboard Shortcuts
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        convertText();
      }
      if ((e.ctrlKey || e.metaKey) && e.altKey && (e.key === 'C' || e.key === 'c')) {
        e.preventDefault();
        if (currentMode === 'file' && fileB64Output.value) {
          window.copyToClipboard(fileB64Output.value, 'Base64 code copied!');
        } else if (textOutput.value) {
          window.copyToClipboard(textOutput.value, 'Result copied to clipboard!');
        }
      }
    });
  });
</script>
