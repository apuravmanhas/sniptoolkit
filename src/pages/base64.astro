            📁
          </div>
          <h3 class="text-lg font-bold text-text-primary mb-1">Upload File to Encode Base64</h3>
          <p class="text-xs text-text-secondary mb-6 leading-relaxed">
            Drag and drop any image (PNG, JPG, SVG, WebP), PDF, binary, or text document here, or click to browse files.
          </p>

          <button id="btn-browse-file" class="px-6 py-2.5 text-xs font-bold rounded-xl bg-accent hover:bg-accent-hover text-white shadow-md shadow-accent/20 transition-all cursor-pointer">
            Browse File
          </button>
        </div>
      </div>

      <!-- File Output Result Section (Hidden until file selected) -->
      <div id="file-result-container" class="hidden grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Preview Box (If Image) -->
        <div class="lg:col-span-1 flex flex-col rounded-2xl border border-border-primary bg-bg-secondary p-4 justify-between">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-text-primary mb-3">File Summary</div>
            <div id="file-preview-box" class="w-full h-48 rounded-xl bg-bg-primary border border-border-primary flex items-center justify-center overflow-hidden mb-4 p-2">
              <span class="text-xs text-text-tertiary">No visual preview</span>
            </div>
            <div class="space-y-2 text-xs font-mono text-text-secondary">
              <div class="flex justify-between"><span class="text-text-tertiary">Filename:</span> <span id="file-name-stat" class="text-text-primary truncate max-w-[160px]">-</span></div>
              <div class="flex justify-between"><span class="text-text-tertiary">Type:</span> <span id="file-type-stat" class="text-text-primary">-</span></div>
              <div class="flex justify-between"><span class="text-text-tertiary">Raw Size:</span> <span id="file-size-stat" class="text-text-primary">-</span></div>
              <div class="flex justify-between"><span class="text-text-tertiary">Base64 Size:</span> <span id="file-b64-size-stat" class="text-accent font-bold">-</span></div>
            </div>
          </div>
        </div>

        <!-- Output Options & Code Box -->
