---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  {
    name: 'JSON Formatter & Validator',
    slug: '/json-formatter/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5c0 1.1.9 2 2 2h1"/><path d="M16 21h1a2 2 0 0 0 2-2v-5c0-1.1.9-2 2-2a2 2 0 0 1-2-2V5a2 2 0 0 0-2-2h-1"/></svg>',
    category: 'Data',
    description: 'Format, validate, beautify, and minify JSON data instantly with line error highlighting.',
    badge: 'Popular',
    color: 'from-blue-500/20 to-indigo-500/20 border-blue-500/30'
  },
  {
    name: 'Base64 Encode & Decode',
    slug: '/base64/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
    category: 'Encoding',
    description: 'Encode text or files to Base64 format and decode Base64 strings back to original format.',
    badge: 'Essential',
    color: 'from-purple-500/20 to-pink-500/20 border-purple-500/30'
  },
  {
    name: 'UUID Generator',
    slug: '/uuid-generator/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="9" y2="9"/><line x1="4" x2="20" y1="15" y2="15"/><line x1="10" x2="8" y1="3" y2="21"/><line x1="16" x2="14" y1="3" y2="21"/></svg>',
    category: 'Generator',
    description: 'Generate random UUIDs (v4 & v7) in bulk with custom formatting options.',
    badge: 'Developer',
    color: 'from-emerald-500/20 to-teal-500/20 border-emerald-500/30'
  },
  {
    name: 'URL Encode & Decode',
    slug: '/url-encode-decode/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>',
    category: 'Encoding',
    description: 'Safely encode special characters for URLs or decode percent-encoded query strings.',
    badge: 'Fast',
    color: 'from-amber-500/20 to-orange-500/20 border-amber-500/30'
  },
  {
    name: 'Unix Timestamp Converter',
    slug: '/timestamp-converter/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
    category: 'Converter',
    description: 'Convert Unix timestamps (epoch) to human-readable date & time and vice-versa.',
    badge: 'Utility',
    color: 'from-cyan-500/20 to-blue-500/20 border-cyan-500/30'
  },
  {
    name: 'Hash Generator (MD5 / SHA)',
    slug: '/hash-generator/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>',
    category: 'Security',
    description: 'Generate secure cryptographic hashes including MD5, SHA-1, SHA-256, and SHA-512.',
    badge: 'Security',
    color: 'from-red-500/20 to-rose-500/20 border-red-500/30'
  },
  {
    name: 'Word & Character Counter',
    slug: '/word-counter/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" x2="15" y1="20" y2="20"/><line x1="12" x2="12" y1="4" y2="20"/></svg>',
    category: 'Text',
    description: 'Count words, characters, sentences, paragraphs, and estimate reading time in real time.',
    badge: 'Writer',
    color: 'from-violet-500/20 to-purple-500/20 border-violet-500/30'
  },
  {
    name: 'Color Picker & Converter',
    slug: '/color-picker/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/></svg>',
    category: 'Design',
    description: 'Convert color codes between HEX, RGB, HSL, and HSV formats with interactive color picker.',
    badge: 'Design',
    color: 'from-fuchsia-500/20 to-pink-500/20 border-fuchsia-500/30'
  },
  {
    name: 'Lorem Ipsum Generator',
    slug: '/lorem-ipsum/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V4h16v3"/><path d="M5 20h6"/><path d="M13 4v16"/><path d="M8 20v-7.5a4.5 4.5 0 0 1 0-9H13"/></svg>',
    category: 'Generator',
    description: 'Generate placeholder text, paragraphs, words, or lists for UI designs and mockups.',
    badge: 'Design',
    color: 'from-sky-500/20 to-blue-500/20 border-sky-500/30'
  },
  {
    name: 'Online Clipboard',
    slug: '/online-clipboard/',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>',
    category: 'Utility',
    description: 'Share text and code snippets seamlessly between multiple devices using a simple 6-digit code.',
    badge: 'Sharing',
    color: 'from-green-500/20 to-emerald-500/20 border-green-500/30'
  }
];

const faqs = [
  {
    question: "Is SnipTools completely free to use?",
    answer: "Yes, 100% free! All developer tools on SnipTools are available without sign-up, subscriptions, or hidden limits."
  },
  {
    question: "Is my data safe when using SnipTools?",
    answer: "Absolutely. All processing occurs 100% locally inside your web browser. Your inputs (JSON, passwords, text, files) are never transmitted or stored on any external server."
  },
  {
    question: "Can I use SnipTools offline?",
    answer: "Yes! SnipTools is built as a lightweight client-side application. Once loaded, most tools function completely offline without an active internet connection."
  },
  {
    question: "How is SnipTools different from other online tool sites?",
    answer: "SnipTools is designed with a modern Vercel-inspired UI, zero intrusive popup ads, blazing-fast speed, dark-mode first design, and instant command palette navigation (Ctrl+K). All tools process data locally — your data never leaves your device."
  },
  {
    question: "What developer tools does SnipTools offer?",
    answer: "SnipTools offers JSON Formatter & Validator, Base64 Encoder/Decoder, UUID v4 & v7 Generator, URL Encoder/Decoder, Unix Timestamp Converter, SHA-256 & MD5 Hash Generator, Word & Character Counter, Color Picker & Converter, Lorem Ipsum Generator, and Online Clipboard sharing — all free and client-side."
  },
  {
    question: "Does SnipTools work on mobile devices?",
    answer: "Yes! SnipTools is fully responsive and works beautifully on smartphones, tablets, and desktop browsers. The interface automatically adapts to your screen size for the best experience."
  }
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "SnipTools",
      "alternateName": ["Snip Tools", "SnipTool", "Snip Toolkit", "SnipTools Developer Suite"],
      "url": "https://sniptoolkit.com/",
      "description": "Fast, free developer & utility tools. 100% client-side, privacy-focused, zero registration.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://sniptoolkit.com/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "name": "SnipTools",
      "alternateName": ["Snip Tools", "Snip Toolkit"],
      "url": "https://sniptoolkit.com/",
      "logo": "https://sniptoolkit.com/favicon-512x512.png"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<BaseLayout
  title="SnipTools (Snip Tools) — Fast, Free Developer & Utility Suite"
  description="Free developer utility suite — JSON formatter, Base64 encoder, UUID generator, Hash generator, Online Clipboard & more. 100% client-side & private."
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative pt-12 pb-12 md:pt-16 md:pb-16 border-b border-border-primary bg-bg-primary">
    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-text-primary max-w-3xl mx-auto mb-6 animate-slide-up">
        Developer Utilities Workspace
      </h1>

      <div class="text-base sm:text-lg text-text-secondary max-w-2xl mx-auto font-mono leading-relaxed mb-10 animate-slide-up stagger-1 text-left sm:text-center inline-block">
        <p class="mb-2">
          <span class="text-[#00FF41] font-bold mr-2">➜</span>
          Other utility sites log your data and bombard you with ads. We built this to be the exact opposite.
        </p>
        <p>
          <span class="text-[#00FF41] font-bold mr-2">➜</span>
          Everything here runs directly in your browser. No servers. No tracking. Just fast, private tools.
        </p>
      </div>

      <!-- Quick Action Bar / Search trigger -->
      <div class="flex flex-col items-center justify-center gap-3 max-w-xl mx-auto animate-slide-up stagger-2">
        <button
          onclick="document.getElementById('command-palette').classList.remove('hidden'); document.getElementById('cmd-search').focus();"
          class="w-full flex items-center justify-between gap-4 px-5 py-3 rounded-xl bg-bg-secondary border border-border-secondary hover:border-accent text-text-secondary hover:text-text-primary shadow-lg shadow-black/20 transition-all duration-200 cursor-pointer group"
        >
          <div class="flex items-center gap-2.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-secondary group-hover:text-accent transition-colors"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <span class="text-sm font-medium">Search tools...</span>
          </div>
          <kbd class="text-xs font-mono bg-bg-tertiary border border-border-primary rounded px-2 py-0.5 text-text-secondary">Ctrl + K</kbd>
        </button>

        <!-- Category Interlink Pills -->
        <div class="flex flex-wrap items-center justify-center gap-1.5 pt-1">
          <span class="text-xs text-text-secondary font-medium mr-1">Popular:</span>
          <a href="#data" class="px-2.5 py-1 rounded-lg bg-bg-secondary/80 border border-border-primary text-xs font-medium text-text-secondary hover:text-text-primary hover:border-accent transition-all no-underline">Data</a>
          <a href="#encoding" class="px-2.5 py-1 rounded-lg bg-bg-secondary/80 border border-border-primary text-xs font-medium text-text-secondary hover:text-text-primary hover:border-accent transition-all no-underline">Encoding</a>
          <a href="#security" class="px-2.5 py-1 rounded-lg bg-bg-secondary/80 border border-border-primary text-xs font-medium text-text-secondary hover:text-text-primary hover:border-accent transition-all no-underline">Security</a>
          <a href="#text" class="px-2.5 py-1 rounded-lg bg-bg-secondary/80 border border-border-primary text-xs font-medium text-text-secondary hover:text-text-primary hover:border-accent transition-all no-underline">Text</a>
          <a href="#generator" class="px-2.5 py-1 rounded-lg bg-bg-secondary/80 border border-border-primary text-xs font-medium text-text-secondary hover:text-text-primary hover:border-accent transition-all no-underline">Generator</a>
          <a href="#converter" class="px-2.5 py-1 rounded-lg bg-bg-secondary/80 border border-border-primary text-xs font-medium text-text-secondary hover:text-text-primary hover:border-accent transition-all no-underline">Converter</a>
          <a href="#design" class="px-2.5 py-1 rounded-lg bg-bg-secondary/80 border border-border-primary text-xs font-medium text-text-secondary hover:text-text-primary hover:border-accent transition-all no-underline">Design</a>
          <a href="#utility" class="px-2.5 py-1 rounded-lg bg-bg-secondary/80 border border-border-primary text-xs font-medium text-text-secondary hover:text-text-primary hover:border-accent transition-all no-underline">Utility</a>
        </div>
      </div>

      <!-- Feature Pills -->
      <div class="flex flex-wrap items-center justify-center gap-6 mt-12 text-xs font-medium text-text-secondary animate-fade-in stagger-3">
        <div class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-success"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Zero Server Uploads</span>
        </div>
        <div class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Instant Execution</span>
        </div>
        <div class="flex items-center gap-2">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-purple"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>100% Secure & Private</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools Grid Section -->
  <section class="py-12 md:py-20 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-10">
      <div>
        <h2 class="text-2xl font-bold text-text-primary tracking-tight">Developer Tools Suite</h2>
        <p class="text-sm text-text-secondary mt-1">Select a utility below to start formatting, generating, or converting.</p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-1.5 p-1 rounded-xl bg-bg-secondary border border-border-primary" id="category-filters">
        <button class="cat-btn active px-3 py-1.5 text-xs font-semibold rounded-lg bg-bg-tertiary text-text-primary transition-all cursor-pointer" data-cat="all">All Tools</button>
        <button class="cat-btn px-3 py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-cat="Data">Data</button>
        <button class="cat-btn px-3 py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-cat="Encoding">Encoding</button>
        <button class="cat-btn px-3 py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-cat="Generator">Generator</button>
        <button class="cat-btn px-3 py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-cat="Security">Security</button>
        <button class="cat-btn px-3 py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-cat="Converter">Converter</button>
        <button class="cat-btn px-3 py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-cat="Text">Text</button>
        <button class="cat-btn px-3 py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-cat="Design">Design</button>
        <button class="cat-btn px-3 py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-cat="Utility">Utility</button>
      </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="tools-grid">
      {tools.map((tool, idx) => (
        <a
          href={tool.slug}
          class={`tool-card group relative p-6 rounded-xl bg-bg-secondary border border-border-primary hover:border-border-hover transition-colors duration-200 no-underline flex flex-col justify-between overflow-hidden`}
          data-category={tool.category}
        >
          <div>
            <!-- Header -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-bg-tertiary border border-border-primary text-text-primary group-hover:border-accent group-hover:scale-105 transition-all duration-300 shadow-inner [&>svg]:w-5 [&>svg]:h-5">
                <Fragment set:html={tool.icon} />
              </div>
              <span class="text-[11px] font-semibold tracking-wide uppercase px-2.5 py-1 rounded-full bg-bg-tertiary border border-border-primary text-text-secondary group-hover:text-accent group-hover:border-accent/40 transition-colors">
                {tool.category}
              </span>
            </div>

            <!-- Title & Desc -->
            <h3 class="text-lg font-bold text-text-primary group-hover:text-accent transition-colors duration-200 mb-2">
              {tool.name}
            </h3>
            <p class="text-xs text-text-secondary leading-relaxed line-clamp-2">
              {tool.description}
            </p>
          </div>

          <!-- Bottom Action -->
          <div class="mt-6 flex items-center justify-between pt-4 border-t border-border-primary/60 text-xs font-semibold text-text-secondary group-hover:text-text-primary transition-colors">
            <span>Open Tool</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transform group-hover:translate-x-1 transition-transform duration-200"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </div>
        </a>
      ))}
    </div>
  </section>
  <!-- SEO Content: What is SnipTools -->
  <section class="py-16 border-t border-border-primary">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-10">
        <div>
          <h2 class="text-2xl font-bold text-text-primary tracking-tight mb-4">What is SnipTools (Snip Tools)?</h2>
          <p class="text-sm text-text-secondary leading-relaxed mb-3">
            SnipTools (also known as Snip Tools) is a free, privacy-first collection of essential developer and utility tools that run entirely inside your web browser. Unlike traditional online utilities that upload your data to remote servers for processing, every Snip Tools operation — from JSON formatting and Base64 encoding to cryptographic hashing and UUID generation — executes locally within your browser's memory using standard Web APIs.
          </p>
          <p class="text-sm text-text-secondary leading-relaxed">
            Built with the Astro static framework and hosted on Cloudflare's global edge network, SnipTools delivers sub-second page loads with zero tracking, zero advertisements, and zero data retention. Whether you are debugging API payloads, encoding configuration files, or generating test data, your sensitive information never leaves your device.
          </p>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-text-primary tracking-tight mb-4">Why Developers Choose SnipTools</h2>
          <ul class="space-y-3 text-sm text-text-secondary">
            <li class="flex items-start gap-2">
              <span class="text-success font-bold mt-0.5">&#10003;</span>
              <span><strong class="text-text-primary">Client-Side Privacy</strong> — All data processing happens locally in your browser memory. No payloads are transmitted to or stored on external servers, making SnipTools safe for handling API keys, tokens, and sensitive configuration data.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-success font-bold mt-0.5">&#10003;</span>
              <span><strong class="text-text-primary">Keyboard-First Navigation</strong> — Press <kbd>Ctrl+K</kbd> or <kbd>Cmd+K</kbd> to open the integrated command palette and instantly search, switch, and navigate between tools without reaching for a mouse.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-success font-bold mt-0.5">&#10003;</span>
              <span><strong class="text-text-primary">Cross-Device Clipboard</strong> — Share code snippets and text between your desktop and mobile devices instantly using ephemeral 6-digit codes and QR codes, without creating accounts or installing applications.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-success font-bold mt-0.5">&#10003;</span>
              <span><strong class="text-text-primary">Ad-Free and Lightweight</strong> — No popup banners, no tracking scripts, no cookie consent dialogs. SnipTools loads instantly with minimal JavaScript overhead, keeping your workflow fast and uninterrupted.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-bg-secondary/40 border-t border-border-primary">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold text-text-primary tracking-tight mb-3">Frequently Asked Questions</h2>
        <p class="text-sm text-text-secondary">Everything you need to know about SnipTools performance and privacy.</p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, i) => (
          <div class="rounded-xl border border-border-primary bg-bg-secondary p-5 transition-all duration-200 hover:border-border-secondary">
            <h3 class="text-base font-semibold text-text-primary mb-2 flex items-center gap-2">
              <span class="text-accent font-bold">Q:</span> {faq.question}
            </h3>
            <p class="text-xs text-text-secondary leading-relaxed pl-6">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('#category-filters .cat-btn');
    const cards = document.querySelectorAll('#tools-grid .tool-card');

    function filterByCategory(catName) {
      if (!catName) catName = 'all';
      const targetCat = catName.toLowerCase().replace('#', '');

      buttons.forEach(btn => {
        const btnCat = (btn.getAttribute('data-cat') || '').toLowerCase();
        if (btnCat === targetCat || (targetCat === '' && btnCat === 'all')) {
          btn.classList.add('active', 'bg-bg-tertiary', 'text-text-primary', 'font-semibold');
          btn.classList.remove('text-text-secondary');
        } else {
          btn.classList.remove('active', 'bg-bg-tertiary', 'text-text-primary', 'font-semibold');
          btn.classList.add('text-text-secondary', 'font-medium');
        }
      });

      cards.forEach(card => {
        const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
        if (targetCat === 'all' || targetCat === '' || cardCat === targetCat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    function checkHashFilter() {
      const hash = window.location.hash.replace('#', '').trim();
      filterByCategory(hash);
      if (hash && hash !== 'all') {
        const section = document.getElementById('category-filters');
        if (section) section.scrollIntoView({ behavior: 'smooth' });
      }
    }

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat');
        filterByCategory(cat);
        if (cat.toLowerCase() === 'all') {
          history.replaceState(null, '', window.location.pathname);
        } else {
          window.location.hash = cat.toLowerCase();
        }
      });
    });

    window.addEventListener('hashchange', checkHashFilter);
    checkHashFilter();
  });
</script>
