---
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Online Screen Ruler",
      "operatingSystem": "Any",
      "applicationCategory": "UtilityApplication",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Free actual size online ruler tool with credit card calibration, screen diagonal calibration, and device auto-detection."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I calibrate the online ruler to actual size?",
          "text": "You can calibrate using 3 methods: 1) Credit Card Calibration by matching a physical credit card against the screen rectangle, 2) Screen Diagonal input (e.g. 15.6 inch laptop screen), or 3) Auto-detecting device DPI."
        },
        {
          "@type": "Question",
          "name": "Is the online ruler accurate on mobile devices?",
          "text": "Yes! When calibrated with a physical credit card or your device's exact screen size in inches, measurements are 100% accurate down to the millimeter."
        },
        {
          "@type": "Question",
          "name": "Which measurement units are supported?",
          "text": "Our actual size ruler supports Inches (in), Centimeters (cm), Millimeters (mm), and Pixels (px)."
        }
      ]
    }
  ]
};

const relatedTools = [
  { name: 'Word & Character Counter', slug: '/word-counter', icon: 'Aa' },
  { name: 'Color Picker & Converter', slug: '/color-picker', icon: '🎨' },
  { name: 'Unix Timestamp Converter', slug: '/timestamp-converter', icon: '⏱' }
];
---

<BaseLayout
  title="Online Ruler — Free Actual Size Screen Calibration Tool | SnipTools"
  description="Free actual size online ruler for your screen. Measure in inches, cm, mm, and px. Calibrate using credit card, screen diagonal, or auto-detect."
  structuredData={structuredData}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Header -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-border-secondary bg-bg-tertiary/80 px-3.5 py-1 text-xs font-semibold text-accent mb-4">
        <span>📏 Precision Measurement Tool</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-text-primary tracking-tight mb-3">
        Online Screen Ruler (Actual Size)
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-2xl mx-auto">
        Accurate online ruler calibrated to actual physical dimensions. Measure anything on screen in inches, cm, mm, or pixels.
      </p>
    </div>

    <!-- Main Workspace -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-12">
      <!-- Control Panel -->
      <div class="lg:col-span-1 space-y-5 rounded-2xl border border-border-primary bg-bg-secondary p-5">
        <h2 class="text-sm font-bold text-text-primary uppercase tracking-wider border-b border-border-primary pb-3">
          Ruler Settings
        </h2>

        <!-- Unit Selection -->
        <div>
          <label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Unit</label>
          <div class="grid grid-cols-2 gap-1.5 p-1 rounded-xl bg-bg-tertiary border border-border-primary">
            <button class="unit-btn active py-1.5 text-xs font-bold rounded-lg bg-accent text-white transition-all cursor-pointer" data-unit="cm">cm / mm</button>
            <button class="unit-btn py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-unit="in">Inches</button>
            <button class="unit-btn py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-unit="px">Pixels (px)</button>
            <button class="unit-btn py-1.5 text-xs font-medium rounded-lg text-text-secondary hover:text-text-primary transition-all cursor-pointer" data-unit="both">Dual (cm+in)</button>
          </div>
        </div>

        <!-- Calibration Tabs -->
        <div>
          <label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Calibration Method</label>
          <div class="space-y-2">
            <!-- Method 1: Credit Card -->
            <button id="tab-cal-card" class="cal-tab-btn active w-full flex items-center gap-3 p-3 rounded-xl border border-accent bg-accent/10 text-left text-xs transition-all cursor-pointer">
              <span class="text-lg">💳</span>
              <div>
                <div class="font-bold text-text-primary">Method 1: Credit Card</div>
                <div class="text-[11px] text-text-tertiary">Match card size on screen</div>
              </div>
            </button>

            <!-- Method 2: Screen Diagonal -->
            <button id="tab-cal-diagonal" class="cal-tab-btn w-full flex items-center gap-3 p-3 rounded-xl border border-border-primary bg-bg-tertiary text-left text-xs transition-all cursor-pointer">
              <span class="text-lg">💻</span>
              <div>
                <div class="font-bold text-text-primary">Method 2: Screen Size</div>
                <div class="text-[11px] text-text-tertiary">Enter diagonal inches</div>
              </div>
            </button>

            <!-- Method 3: Auto-Detect -->
            <button id="tab-cal-auto" class="cal-tab-btn w-full flex items-center gap-3 p-3 rounded-xl border border-border-primary bg-bg-tertiary text-left text-xs transition-all cursor-pointer">
              <span class="text-lg">⚡</span>
              <div>
                <div class="font-bold text-text-primary">Method 3: Auto-Detect</div>
                <div class="text-[11px] text-text-tertiary">Estimate from browser PPI</div>
              </div>
            </button>
          </div>
        </div>

        <!-- Calibration Controls Container -->
        <div id="cal-controls-card" class="cal-control-panel rounded-xl bg-bg-tertiary p-4 border border-border-primary text-xs space-y-3">
          <div class="font-semibold text-text-primary">Credit Card Calibration</div>
          <p class="text-[11px] text-text-secondary">Place a standard credit card against the screen and adjust the slider until the blue rectangle matches the card exactly.</p>
          <div>
            <div class="flex justify-between text-[11px] text-text-tertiary mb-1">
              <span>Card Scale:</span>
              <span id="card-scale-val" class="font-mono font-bold text-accent">1.00x</span>
            </div>
            <input type="range" id="card-scale-slider" min="0.5" max="2.0" step="0.01" value="1.0" class="w-full accent-accent cursor-pointer" />
          </div>
          <!-- Virtual Credit Card graphic -->
          <div class="flex justify-center pt-2">
            <div id="virtual-card" class="rounded-lg bg-gradient-to-r from-blue-600 to-indigo-600 border border-blue-400/40 p-3 shadow-lg flex flex-col justify-between text-white" style="width: 250px; height: 158px;">
              <div class="flex justify-between items-center text-[10px] font-mono tracking-widest opacity-80">
                <span>CREDIT CARD</span>
                <span>85.60 mm</span>
              </div>
              <div class="w-8 h-6 bg-amber-400/80 rounded-md my-2"></div>
              <div class="text-[10px] font-mono tracking-widest">•••• •••• •••• 1234</div>
            </div>
          </div>
        </div>

        <div id="cal-controls-diagonal" class="cal-control-panel hidden rounded-xl bg-bg-tertiary p-4 border border-border-primary text-xs space-y-3">
          <div class="font-semibold text-text-primary">Screen Size Calibration</div>
          <p class="text-[11px] text-text-secondary">Enter your monitor or phone screen diagonal size in inches (e.g. 15.6" laptop, 27" monitor, 6.1" iPhone).</p>
          <div>
            <label class="block text-[11px] text-text-tertiary mb-1">Diagonal Inches (in)</label>
            <input type="number" id="diag-input" step="0.1" min="3" max="100" value="15.6" class="w-full rounded-lg bg-bg-secondary border border-border-primary px-3 py-2 text-xs text-text-primary font-mono outline-none focus:border-accent" />
          </div>
          <button id="btn-apply-diag" class="w-full py-2 rounded-lg bg-accent text-white font-semibold hover:bg-accent-hover transition-colors cursor-pointer">
            Calibrate Screen
          </button>
        </div>

        <div id="cal-controls-auto" class="cal-control-panel hidden rounded-xl bg-bg-tertiary p-4 border border-border-primary text-xs space-y-3">
          <div class="font-semibold text-text-primary">Auto-Detect Device DPI</div>
          <p class="text-[11px] text-text-secondary">Uses standard CSS 96 PPI baseline combined with device pixel ratio. Recommended for standard desktop monitors.</p>
          <div class="p-2.5 rounded-lg bg-bg-secondary border border-border-primary text-mono text-[11px] text-text-secondary">
            Detected PPI: <span id="auto-ppi-val" class="font-bold text-accent">96 PPI</span>
          </div>
          <button id="btn-apply-auto" class="w-full py-2 rounded-lg bg-bg-secondary border border-border-primary hover:border-accent text-text-primary font-semibold transition-colors cursor-pointer">
            Reset to Auto
          </button>
        </div>

        <!-- Position Option -->
        <div>
          <label class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Ruler Placement</label>
          <select id="ruler-pos-select" class="w-full rounded-lg bg-bg-tertiary border border-border-primary px-3 py-2 text-xs text-text-primary outline-none focus:border-accent cursor-pointer">
            <option value="horizontal">Horizontal (Top)</option>
            <option value="vertical">Vertical (Left)</option>
            <option value="box">Floating Box Ruler</option>
          </select>
        </div>
      </div>

      <!-- Ruler Display Canvas Container -->
      <div class="lg:col-span-3 rounded-2xl border border-border-primary bg-bg-secondary p-6 flex flex-col justify-between relative overflow-hidden min-h-[450px]">
        <!-- Ruler Info Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-border-primary text-xs">
          <div class="flex items-center gap-3 text-text-secondary">
            <span>Calibrated PPI: <strong id="current-ppi-display" class="font-mono text-accent">96.0</strong></span>
            <span>•</span>
            <span>Current Scale: <strong id="current-unit-display" class="font-mono text-text-primary">cm / mm</strong></span>
          </div>
          <button id="btn-reset-calibration" class="text-xs text-text-tertiary hover:text-accent cursor-pointer">
            ↺ Reset Calibration
          </button>
        </div>

        <!-- Interactive Ruler Canvas Element -->
        <div class="flex-1 my-6 flex items-center justify-center relative overflow-auto" id="ruler-viewport">
          <div id="ruler-wrapper" class="w-full flex justify-center py-4">
            <!-- Canvas ruler rendered via JS -->
            <canvas id="ruler-canvas" class="border border-border-secondary rounded-xl bg-bg-primary shadow-2xl transition-all cursor-crosshair"></canvas>
          </div>
        </div>

        <!-- Pointer Reading Display -->
        <div class="pt-4 border-t border-border-primary flex items-center justify-between text-xs text-text-secondary">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            <span>Click/Drag anywhere on ruler to measure length:</span>
          </div>
          <div class="font-mono text-sm font-bold text-accent bg-accent/10 border border-accent/20 px-3 py-1 rounded-lg" id="measurement-reading">
            0.00 cm (0.00 in)
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Content Section -->
    <div class="rounded-2xl border border-border-primary bg-bg-secondary p-6 sm:p-10 mb-12 space-y-6 text-sm text-text-secondary leading-relaxed">
      <h2 class="text-2xl font-bold text-text-primary tracking-tight">How to Use the Online Ruler (Actual Size)</h2>
      <p>
        An online ruler measures physical objects placed against your computer screen, laptop, or mobile phone. Because different monitors have different pixel densities (PPI/DPI), an uncalibrated screen ruler might show incorrect dimensions.
      </p>
      
      <h3 class="text-lg font-bold text-text-primary pt-2">3 Easy Calibration Methods</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-4 rounded-xl bg-bg-tertiary border border-border-primary">
          <h4 class="font-bold text-text-primary mb-1">1. Credit Card Calibration</h4>
          <p class="text-xs text-text-tertiary">Standard credit cards are exactly 85.60 mm (3.37 inches) wide worldwide. Hold any card to your screen and adjust the slider until the blue rectangle matches the card width perfectly.</p>
        </div>
        <div class="p-4 rounded-xl bg-bg-tertiary border border-border-primary">
          <h4 class="font-bold text-text-primary mb-1">2. Screen Size Diagonal</h4>
          <p class="text-xs text-text-tertiary">Enter your screen's advertised diagonal size in inches (for example, 15.6" for a laptop or 27" for a desktop monitor). The tool calculates the exact PPI using your screen resolution.</p>
        </div>
        <div class="p-4 rounded-xl bg-bg-tertiary border border-border-primary">
          <h4 class="font-bold text-text-primary mb-1">3. Auto-Detect Device</h4>
          <p class="text-xs text-text-tertiary">Uses standard browser device pixel ratio and CSS reference pixels (96 DPI baseline). Works instantly for standard desktop displays without physical calibration.</p>
        </div>
      </div>
    </div>

    <!-- Related Tools -->
    <div>
      <h3 class="text-lg font-bold text-text-primary mb-4">Related Developer & Design Tools</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {relatedTools.map(tool => (
          <a href={tool.slug} class="p-4 rounded-xl bg-bg-secondary border border-border-primary hover:border-accent transition-all flex items-center gap-3 no-underline">
            <span class="text-xl">{tool.icon}</span>
            <span class="text-sm font-semibold text-text-primary">{tool.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // Ruler Calibration & Drawing Engine
  let currentPpi = 96; // Baseline pixels per inch
  let currentUnit = 'cm'; // 'cm', 'in', 'px', 'both'
  let rulerPosition = 'horizontal';
  let pointerX = 0;

  const canvas = document.getElementById('ruler-canvas');
  const ctx = canvas ? canvas.getContext('2d') : null;
  const ppiDisplay = document.getElementById('current-ppi-display');
  const unitDisplay = document.getElementById('current-unit-display');
  const readingDisplay = document.getElementById('measurement-reading');

  // Standard Credit Card width in inches = 85.60 mm = 3.37007874 inches
  const CREDIT_CARD_INCHES = 3.37007874;

  function initRuler() {
    if (!canvas || !ctx) return;
    resizeCanvas();
    drawRuler();
    setupEventListeners();
  }

  function resizeCanvas() {
    const container = document.getElementById('ruler-viewport');
    const width = Math.min(container ? container.clientWidth - 32 : 700, 900);
    const height = rulerPosition === 'vertical' ? 600 : 180;

    canvas.width = width * window.devicePixelRatio;
    canvas.height = height * window.devicePixelRatio;
    canvas.style.width = width + 'px';
    canvas.style.height = height + 'px';

    ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  }

  function drawRuler() {
    if (!ctx) return;
    const w = canvas.width / window.devicePixelRatio;
    const h = canvas.height / window.devicePixelRatio;

    // Clear
    ctx.clearRect(0, 0, w, h);

    // Background
    ctx.fillStyle = '#0a0a0a';
    ctx.fillRect(0, 0, w, h);

    // Border
    ctx.strokeStyle = '#333333';
    ctx.lineWidth = 1;
    ctx.strokeRect(0, 0, w, h);

    const isLight = document.documentElement.classList.contains('light');
    const textColor = isLight ? '#171717' : '#ededed';
    const tickColor = isLight ? '#525252' : '#737373';
    const accentColor = '#3b82f6';

    ctx.font = '10px "JetBrains Mono", monospace';
    ctx.fillStyle = textColor;
    ctx.strokeStyle = tickColor;

    if (currentUnit === 'cm' || currentUnit === 'both') {
      // Centimeters & Millimeters (1 inch = 2.54 cm)
      const pixelsPerCm = currentPpi / 2.54;
      const pixelsPerMm = pixelsPerCm / 10;
      const totalMm = Math.floor(w / pixelsPerMm);

      for (let mm = 0; mm <= totalMm; mm++) {
        const x = mm * pixelsPerMm;
        let tickHeight = 8;

        if (mm % 10 === 0) {
          tickHeight = 25;
          const cmNum = mm / 10;
          ctx.fillText(cmNum.toString(), x + 3, 38);
        } else if (mm % 5 === 0) {
          tickHeight = 16;
        }

        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, tickHeight);
        ctx.stroke();
      }

      // Label unit
      ctx.fillStyle = accentColor;
      ctx.fillText('CM / MM', w - 50, 20);
    }

    if (currentUnit === 'in' || currentUnit === 'both') {
      // Inches & 1/16th subdivisions
      const pixelsPerInch = currentPpi;
      const pixelsPer16th = pixelsPerInch / 16;
      const startY = currentUnit === 'both' ? h / 2 : 0;
      const total16ths = Math.floor(w / pixelsPer16th);

      ctx.fillStyle = textColor;
      ctx.strokeStyle = tickColor;

      for (let i = 0; i <= total16ths; i++) {
        const x = i * pixelsPer16th;
        let tickHeight = 6;

        if (i % 16 === 0) {
          tickHeight = 24;
          const inchNum = i / 16;
          ctx.fillText(inchNum + '"', x + 4, startY + 36);
        } else if (i % 8 === 0) {
          tickHeight = 18;
        } else if (i % 4 === 0) {
          tickHeight = 12;
        } else if (i % 2 === 0) {
          tickHeight = 9;
        }

        ctx.beginPath();
        ctx.moveTo(x, currentUnit === 'both' ? h - tickHeight : tickHeight);
        ctx.lineTo(x, currentUnit === 'both' ? h : 0);
        ctx.stroke();
      }

      ctx.fillStyle = accentColor;
      ctx.fillText('INCHES', w - 50, currentUnit === 'both' ? h - 10 : 20);
    }

    if (currentUnit === 'px') {
      // Pixels (every 10px, 50px, 100px)
      const totalPx = w;
      for (let px = 0; px <= totalPx; px += 10) {
        let tickHeight = 6;
        if (px % 100 === 0) {
          tickHeight = 22;
          ctx.fillText(px + 'px', px + 3, 34);
        } else if (px % 50 === 0) {
          tickHeight = 14;
        }

        ctx.beginPath();
        ctx.moveTo(px, 0);
        ctx.lineTo(px, tickHeight);
        ctx.stroke();
      }
      ctx.fillStyle = accentColor;
      ctx.fillText('PIXELS', w - 50, 20);
    }

    // Pointer line
    if (pointerX > 0 && pointerX <= w) {
      ctx.strokeStyle = accentColor;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(pointerX, 0);
      ctx.lineTo(pointerX, h);
      ctx.stroke();

      // Circle marker
      ctx.fillStyle = accentColor;
      ctx.beginPath();
      ctx.arc(pointerX, h / 2, 4, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  function updateMeasurements(xPx) {
    pointerX = xPx;
    const inches = xPx / currentPpi;
    const cm = inches * 2.54;
    const mm = cm * 10;
    const px = Math.round(xPx);

    if (readingDisplay) {
      readingDisplay.textContent = `${cm.toFixed(2)} cm (${inches.toFixed(2)} in / ${px} px)`;
    }
    drawRuler();
  }

  function setupEventListeners() {
    // Unit buttons
    document.querySelectorAll('.unit-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.unit-btn').forEach(b => {
          b.classList.remove('active', 'bg-accent', 'text-white', 'font-bold');
          b.classList.add('text-text-secondary', 'font-medium');
        });
        btn.classList.add('active', 'bg-accent', 'text-white', 'font-bold');
        btn.classList.remove('text-text-secondary');

        currentUnit = btn.getAttribute('data-unit');
        if (unitDisplay) unitDisplay.textContent = currentUnit;
        drawRuler();
      });
    });

    // Calibration Tabs
    const tabCard = document.getElementById('tab-cal-card');
    const tabDiag = document.getElementById('tab-cal-diagonal');
    const tabAuto = document.getElementById('tab-cal-auto');

    const panelCard = document.getElementById('cal-controls-card');
    const panelDiag = document.getElementById('cal-controls-diagonal');
    const panelAuto = document.getElementById('cal-controls-auto');

    function switchCalTab(activeTab, activePanel) {
      [tabCard, tabDiag, tabAuto].forEach(t => t?.classList.remove('active', 'border-accent', 'bg-accent/10'));
      [panelCard, panelDiag, panelAuto].forEach(p => p?.classList.add('hidden'));

      activeTab?.classList.add('active', 'border-accent', 'bg-accent/10');
      activePanel?.classList.remove('hidden');
    }

    tabCard?.addEventListener('click', () => switchCalTab(tabCard, panelCard));
    tabDiag?.addEventListener('click', () => switchCalTab(tabDiag, panelDiag));
    tabAuto?.addEventListener('click', () => switchCalTab(tabAuto, panelAuto));

    // Credit Card Slider
    const cardSlider = document.getElementById('card-scale-slider');
    const cardScaleVal = document.getElementById('card-scale-val');
    const virtualCard = document.getElementById('virtual-card');

    if (cardSlider) {
      cardSlider.addEventListener('input', (e) => {
        const scale = parseFloat(e.target.value);
        if (cardScaleVal) cardScaleVal.textContent = scale.toFixed(2) + 'x';
        
        // Base width for card = 250px * scale
        const cardPx = 250 * scale;
        if (virtualCard) virtualCard.style.width = cardPx + 'px';
        if (virtualCard) virtualCard.style.height = (cardPx / 1.586) + 'px';

        // Calculate PPI: card is 3.37 inches wide
        currentPpi = cardPx / CREDIT_CARD_INCHES;
        if (ppiDisplay) ppiDisplay.textContent = currentPpi.toFixed(1);
        drawRuler();
      });
    }

    // Diagonal Calibration
    document.getElementById('btn-apply-diag')?.addEventListener('click', () => {
      const diagInches = parseFloat(document.getElementById('diag-input').value) || 15.6;
      const screenW = window.screen.width;
      const screenH = window.screen.height;
      const diagPx = Math.sqrt(screenW * screenW + screenH * screenH);
      currentPpi = diagPx / diagInches;

      if (ppiDisplay) ppiDisplay.textContent = currentPpi.toFixed(1);
      drawRuler();
      if (window.showToast) window.showToast(`Calibrated to ${diagInches}" screen (${currentPpi.toFixed(1)} PPI)`, 'success');
    });

    // Auto Detect
    document.getElementById('btn-apply-auto')?.addEventListener('click', () => {
      currentPpi = 96 * (window.devicePixelRatio || 1);
      if (ppiDisplay) ppiDisplay.textContent = currentPpi.toFixed(1);
      drawRuler();
      if (window.showToast) window.showToast('Reset to Auto-detected PPI', 'info');
    });

    // Reset Calibration
    document.getElementById('btn-reset-calibration')?.addEventListener('click', () => {
      currentPpi = 96;
      if (ppiDisplay) ppiDisplay.textContent = '96.0';
      if (cardSlider) cardSlider.value = 1.0;
      if (cardScaleVal) cardScaleVal.textContent = '1.00x';
      drawRuler();
      if (window.showToast) window.showToast('Ruler reset to standard 96 PPI', 'info');
    });

    // Canvas Mouse Click/Drag for measurement
    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      updateMeasurements(x);
    });

    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      updateMeasurements(x);
    });

    window.addEventListener('resize', () => {
      resizeCanvas();
      drawRuler();
    });
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', initRuler);
  setTimeout(initRuler, 100);
</script>
