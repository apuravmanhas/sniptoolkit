---
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About SnipTools",
  "description": "SnipTools is a fast, free developer and utility tools suite designed with a 100% client-side privacy-first architecture."
};
---

<BaseLayout
  title="About SnipTools — Fast, Free Developer Tools Hub"
  description="Learn about SnipTools — free developer and utility tools built for speed, privacy, and simplicity. 100% client-side processing."
  structuredData={structuredData}
>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="mb-10 text-center">
      <span class="inline-block px-3 py-1 text-xs font-semibold text-accent bg-accent/10 border border-accent/20 rounded-full mb-3">
        Our Mission
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight mb-3">About SnipTools</h1>
      <p class="text-base text-text-secondary max-w-2xl mx-auto">
        Building the fastest, cleanest, and most private developer utility hub on the web.
      </p>
    </div>

    <!-- Main Card -->
    <div class="rounded-2xl border border-border-primary bg-bg-secondary p-6 sm:p-10 space-y-8 text-sm text-text-secondary leading-relaxed">
      <div>
        <h2 class="text-xl font-bold text-text-primary mb-3">Why We Built SnipTools</h2>
        <p>
          Developers, designers, and creators use utility tools dozens of times every single day—formatting JSON payloads, converting timestamps, decoding Base64 strings, or hashing secret keys.
        </p>
        <p class="mt-3">
          Unfortunately, most online tool websites are bloated with intrusive popup ads, slow page loads, heavy server dependencies, and questionable data privacy practices. We built <strong class="text-text-primary">SnipTools</strong> to solve this.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-b border-border-primary py-8 my-6">
        <div class="p-4 rounded-xl bg-bg-tertiary border border-border-primary text-center">
          <div class="text-2xl font-extrabold text-accent mb-1">100%</div>
          <div class="text-xs font-medium text-text-secondary">Client-Side Execution</div>
        </div>
        <div class="p-4 rounded-xl bg-bg-tertiary border border-border-primary text-center">
          <div class="text-2xl font-extrabold text-success mb-1">0ms</div>
          <div class="text-xs font-medium text-text-secondary">Server Latency</div>
        </div>
        <div class="p-4 rounded-xl bg-bg-tertiary border border-border-primary text-center">
          <div class="text-2xl font-extrabold text-purple mb-1">0</div>
          <div class="text-xs font-medium text-text-secondary">Sign-Up Required</div>
        </div>
      </div>

      <div>
        <h2 class="text-xl font-bold text-text-primary mb-3">Our Core Principles</h2>
        <div class="space-y-4">
          <div class="flex gap-3">
            <div class="w-6 h-6 rounded-full bg-accent/20 text-accent flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">1</div>
            <div>
              <h3 class="font-bold text-text-primary">Privacy First</h3>
              <p class="text-xs text-text-secondary mt-1">Your code, JSON payloads, passwords, and data never leave your browser. All computations run locally on your device.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="w-6 h-6 rounded-full bg-success/20 text-success flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">2</div>
            <div>
              <h3 class="font-bold text-text-primary">Blazing Speed</h3>
              <p class="text-xs text-text-secondary mt-1">Built with Astro 7, vanilla JavaScript, and Cloudflare CDN. Sub-second load times and instantaneous tool response.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="w-6 h-6 rounded-full bg-purple/20 text-purple flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">3</div>
            <div>
              <h3 class="font-bold text-text-primary">Vercel-Inspired UI</h3>
              <p class="text-xs text-text-secondary mt-1">A sleek, modern dark-mode interface with instant command palette search (Ctrl+K) and fluid keyboard navigation.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
